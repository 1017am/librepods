+package me.kavishdevar.librepods.companion
+
+import android.companion.AssociationInfo
+import android.companion.CompanionDeviceService
+import android.companion.DevicePresenceEvent
+import android.content.Intent
+import android.os.Build
+import android.util.Log
+import androidx.annotation.RequiresApi
+import me.kavishdevar.librepods.services.AirPodsService
+import me.kavishdevar.librepods.utils.AutoConnectPermissions
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/**
+ * Bound by the system (CompanionDeviceManager) when an associated AirPods' *classic* Bluetooth
+ * link comes up — also when our process was dead. Being associated additionally exempts the app
+ * from the Android 12+ "no foreground service from background" rule
+ * (REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND).
+ *
+ * Note: CDM's BLE presence can't be used for AirPods (they advertise with a rotating RPA), so
+ * this only fires on BT-classic connect. BLE lid/in-ear detection is done by BLEManager.
+ */
+class AirPodsCompanionService : CompanionDeviceService() {
+
+    @Deprecated("Replaced by onDevicePresenceEvent on API 36+, still called on 33–35")
+    override fun onDeviceAppeared(associationInfo: AssociationInfo) {
+        Log.i(TAG, "CDM: device appeared (${associationInfo.deviceMacAddress})")
+        wakeService()
+    }
+
+    @Deprecated("Replaced by onDevicePresenceEvent on API 36+, still called on 33–35")
+    override fun onDeviceDisappeared(associationInfo: AssociationInfo) {
+        Log.i(TAG, "CDM: device disappeared (${associationInfo.deviceMacAddress})")
+    }
+
+    @RequiresApi(36)
+    override fun onDevicePresenceEvent(event: DevicePresenceEvent) {
+        Log.i(TAG, "CDM presence event ${event.event} for association ${event.associationId}")
+        if (event.event == DevicePresenceEvent.EVENT_BT_CONNECTED ||
+            event.event == DevicePresenceEvent.EVENT_BLE_APPEARED
+        ) {
+            wakeService()
+        }
+    }
+
+    private fun wakeService() {
+        if (!AutoConnectPermissions.canStartConnectedDeviceFgs(this)) {
+            Log.w(TAG, "Not starting AirPodsService: no Bluetooth runtime permission (Android 14 FGS rule)")
+            return
+        }
+        try {
+            startForegroundService(
+                Intent(this, AirPodsService::class.java).setAction(ACTION_CDM_APPEARED)
+            )
+        } catch (e: Exception) {
+            // ForegroundServiceStartNotAllowedException etc. — logged, not fatal.
+            Log.e(TAG, "Failed to start AirPodsService from CDM (sdk=${Build.VERSION.SDK_INT})", e)
+        }
+    }
+
+    companion object {
+        private const val TAG = "AirPodsCDM"
+        const val ACTION_CDM_APPEARED = "me.kavishdevar.librepods.CDM_DEVICE_APPEARED"
+    }
+}
