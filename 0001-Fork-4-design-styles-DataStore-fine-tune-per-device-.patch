+/** Switch row. When [disabledReason] is non-null the row is disabled AND the reason is shown —
+ *  never a toggle that silently does nothing. */
+@Composable
+fun ForkSwitchRow(
+    label: String,
+    checked: Boolean,
+    onCheckedChange: (Boolean) -> Unit,
+    description: String? = null,
+    disabledReason: String? = null,
+) {
+    val enabled = disabledReason == null
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .heightIn(min = MinTouchTarget)
+            .toggleable(value = checked, enabled = enabled, role = Role.Switch, onValueChange = onCheckedChange)
+            .padding(horizontal = 16.dp, vertical = 10.dp)
+    ) {
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                label,
+                style = MaterialTheme.typography.bodyLarge,
+                color = if (enabled) MaterialTheme.colorScheme.onSurface else MaterialTheme.colorScheme.onSurfaceVariant
+            )
+            val sub = disabledReason ?: description
+            if (sub != null) {
+                Text(
+                    sub,
+                    style = MaterialTheme.typography.bodySmall,
+                    color = if (disabledReason != null) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant
+                )
+            }
+        }
+        Spacer(Modifier.width(12.dp))
+        // The row handles the toggle; the Switch is visual only (avoids two focus stops).
+        Switch(checked = checked, onCheckedChange = null, enabled = enabled)
+    }
+}
+
+/**
+ * Slider with 1-unit precision: drag for coarse, −/+ buttons for exact steps, value always shown
+ * as text (not only by thumb position).
+ */
+@Composable
+fun PreciseSlider(
+    label: String,
+    value: Int,
+    range: IntRange,
+    onValueChange: (Int) -> Unit,
+    valueText: (Int) -> String = { it.toString() },
+    endsText: String? = null,
+    disabledReason: String? = null,
+    step: Int = 1,
+) {
+    val enabled = disabledReason == null
+    val decreaseLabel = stringResource(R.string.fork_decrease, label)
+    val increaseLabel = stringResource(R.string.fork_increase, label)
+    Column(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.fillMaxWidth()) {
+            Text(label, style = MaterialTheme.typography.bodyLarge, modifier = Modifier.weight(1f))
+            Text(
+                valueText(value),
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.SemiBold,
+                color = if (enabled) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurfaceVariant
+            )
+        }
+        Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.fillMaxWidth()) {
+            FilledTonalIconButton(
+                onClick = { onValueChange((value - step).coerceIn(range)) },
+                enabled = enabled && value > range.first,
+                modifier = Modifier.size(MinTouchTarget).semantics { contentDescription = decreaseLabel }
+            ) { Text("−", style = MaterialTheme.typography.titleLarge) }
+            Slider(
+                value = value.toFloat(),
+                onValueChange = { onValueChange(it.roundToInt().coerceIn(range)) },
+                valueRange = range.first.toFloat()..range.last.toFloat(),
+                steps = ((range.last - range.first) / step - 1).coerceAtLeast(0),
+                enabled = enabled,
+                modifier = Modifier
+                    .weight(1f)
+                    .padding(horizontal = 8.dp)
+                    .semantics { stateDescription = valueText(value) }
+            )
+            FilledTonalIconButton(
+                onClick = { onValueChange((value + step).coerceIn(range)) },
+                enabled = enabled && value < range.last,
+                modifier = Modifier.size(MinTouchTarget).semantics { contentDescription = increaseLabel }
+            ) { Text("+", style = MaterialTheme.typography.titleLarge) }
+        }
+        val sub = disabledReason ?: endsText
+        if (sub != null) {
+            Text(
+                sub,
+                style = MaterialTheme.typography.bodySmall,
+                color = if (disabledReason != null) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant
+            )
+        }
+    }
+}
+
+/** Label/value row whose meaning is never carried by colour alone. */
+@Composable
+fun ForkInfoRow(label: String, value: String, valueIsProblem: Boolean = false, trailing: (@Composable () -> Unit)? = null) {
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .heightIn(min = MinTouchTarget)
+            .padding(horizontal = 16.dp, vertical = 8.dp)
+            .then(if (trailing == null) Modifier.clearAndSetSemantics { contentDescription = "$label: $value" } else Modifier)
+    ) {
+        Column(Modifier.weight(1f)) {
+            Text(label, style = MaterialTheme.typography.bodyLarge)
+            Text(
+                value,
+                style = MaterialTheme.typography.bodySmall,
+                color = if (valueIsProblem) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant
+            )
+        }
+        if (trailing != null) {
+            Spacer(Modifier.width(8.dp))
+            Column(Modifier.widthIn(min = MinTouchTarget), horizontalAlignment = Alignment.End, verticalArrangement = Arrangement.Center) {
+                trailing()
+            }
+        }
+    }
+}
