+
+// NOTE: this file must stay free of android.* imports — it is compiled and unit-tested on the JVM.
+package me.kavishdevar.librepods.bluetooth.autoconnect
+
+/** What the home screen shows. Order is roughly "worst" → "best". */
+enum class ConnectionPhase {
+    /** Service not running yet. */
+    IDLE,
+    MISSING_PERMISSION,
+    BLUETOOTH_OFF,
+    /** No AirPods bonded / no MAC remembered yet. */
+    NO_PAIRED_DEVICE,
+    /** Bonded, but no IRK yet → BLE detection impossible until one manual L2CAP connection. */
+    NO_PROXIMITY_KEYS,
+    /** User pressed "disconnect" (or another Apple device took over); waits for a new gesture. */
+    PAUSED,
+    SEARCHING,
+    NEARBY,
+    /** Our AirPods are playing/calling on another host and the user asked us not to steal them. */
+    IN_USE_ELSEWHERE,
+    CONNECTING,
+    CONNECTED,
+    FAILED,
+}
+
+enum class FailureReason {
+    SOCKET_TIMEOUT,
+    SOCKET_ERROR,
+    /** createBluetoothSocket() failed: hidden-API / L2CAP not available on this OS build. */
+    L2CAP_UNAVAILABLE,
+    NOT_BONDED,
+    BLUETOOTH_OFF,
+    PERMISSION,
+    UNKNOWN,
+}
+
+enum class BatterySource {
+    /** Plain proximity broadcast, 10 % steps. */
+    BLE_ESTIMATE,
+    /** Proximity broadcast decrypted with ENC_KEY, 1 % steps. */
+    BLE_DECRYPTED,
+    /** Reported over the AACP (L2CAP) connection. */
+    AACP,
+}
+
+data class BudBattery(val level: Int?, val charging: Boolean = false)
+
+data class BatterySnapshot(
+    val left: BudBattery,
+    val right: BudBattery,
+    val case: BudBattery,
+    val source: BatterySource,
+)
+
+enum class Trigger { LID_OPENED, PUT_IN_EAR, NEARBY, REMOTE_DISCONNECTED, UNEXPECTED_DISCONNECT, MANUAL }
+
+/** Remote connection states as decoded by BLEManager.connStates. */
+object RemoteState {
+    const val DISCONNECTED = "Disconnected"
+    const val IDLE = "Idle"
+    const val MUSIC = "Music"
+    const val CALL = "Call"
+    const val RINGING = "Ringing"
+    const val HANGING_UP = "Hanging Up"
+    val ACTIVE = setOf(MUSIC, CALL, RINGING, HANGING_UP)
+}
+
+/** One BLE observation of one of *our* AirPods (already IRK-verified by BLEManager). */
+data class Sighting(
+    /** Resolvable private address the broadcast came from (rotates). */
+    val rpa: String,
+    /** Classic BT identity address resolved via the per-device IRK, null if unknown. */
+    val identityAddress: String?,
+    val rssi: Int,
+    val lidOpen: Boolean,
+    val leftInEar: Boolean,
+    val rightInEar: Boolean,
+    val remoteState: String,
+    val seenAtMillis: Long,
+) {
+    val anyInEar: Boolean get() = leftInEar || rightInEar
+    /** "Out and about": lid open or worn. */
+    val active: Boolean get() = lidOpen || anyInEar
+}
+
+data class AutoConnectSettings(
+    val enabled: Boolean = true,
+    val onLidOpen: Boolean = true,
+    val onInEar: Boolean = true,
+    val onNearby: Boolean = false,
+    /** dBm; -60 ≈ same room, -75 ≈ a few rooms away. */
+    val nearbyRssiThreshold: Int = -60,
+    /** Don't grab the AirPods while another host is playing music / in a call. */
+    val respectActiveOtherDevice: Boolean = true,
+    val maxAttempts: Int = 5,
+    /** Reconnect automatically after an unexpected link loss while still worn / lid open. */
+    val reconnectOnLinkLoss: Boolean = true,
+)
+
+data class ConnectionStatus(
+    val phase: ConnectionPhase = ConnectionPhase.IDLE,
+    val deviceName: String? = null,
+    val identityAddress: String? = null,
+    val battery: BatterySnapshot? = null,
+    val lidOpen: Boolean = false,
+    val leftInEar: Boolean = false,
+    val rightInEar: Boolean = false,
+    val rssi: Int? = null,
+    val attempt: Int = 0,
+    val maxAttempts: Int = 0,
+    val nextRetryAtMillis: Long? = null,
+    val failure: FailureReason? = null,
+    val failureDetail: String? = null,
+    /** Other IRK-verified (= the user's own) AirPods currently broadcasting. */
+    val otherOwnDevicesNearby: Int = 0,
+    /** Whether audio profiles can be (re)connected by us (needs BLUETOOTH_PRIVILEGED). */
+    val canConnectAudioProfiles: Boolean = false,
+    val updatedAtMillis: Long = 0L,
+)
