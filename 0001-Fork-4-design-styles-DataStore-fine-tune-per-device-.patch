+@Composable
+private fun StyleOption(style: AppStyle, selected: Boolean, enabled: Boolean, onSelect: () -> Unit) {
+    val dark = isSystemInDarkTheme()
+    val scheme = when (style) {
+        AppStyle.TOSS -> if (dark) TossDark else TossLight
+        AppStyle.APPLE -> if (dark) AppleAaDark else AppleAaLight
+        AppStyle.SAMSUNG -> if (dark) SamsungDark else SamsungLight
+        AppStyle.MATERIAL -> if (dark) MaterialStaticDark else MaterialStaticLight
+    }
+    val (title, desc) = when (style) {
+        AppStyle.TOSS -> R.string.fork_style_toss to R.string.fork_style_toss_desc
+        AppStyle.APPLE -> R.string.fork_style_apple to R.string.fork_style_apple_desc
+        AppStyle.SAMSUNG -> R.string.fork_style_samsung to R.string.fork_style_samsung_desc
+        AppStyle.MATERIAL -> R.string.fork_style_material to R.string.fork_style_material_desc
+    }
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .heightIn(min = MinTouchTarget)
+            .selectable(selected = selected, enabled = enabled, role = Role.RadioButton, onClick = onSelect)
+            .padding(horizontal = 16.dp, vertical = 10.dp)
+    ) {
+        RadioButton(selected = selected, onClick = null, enabled = enabled)
+        Spacer(Modifier.width(12.dp))
+        Column(Modifier.weight(1f)) {
+            Text(stringResource(title), style = MaterialTheme.typography.bodyLarge, fontWeight = FontWeight.Medium)
+            Text(stringResource(desc), style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        Spacer(Modifier.width(12.dp))
+        // Mini preview in that style's own palette & card radius (decorative).
+        Box(
+            Modifier
+                .size(width = 64.dp, height = 44.dp)
+                .background(scheme.surfaceContainer, RoundedCornerShape(style.shapes().control))
+                .border(1.dp, scheme.outlineVariant, RoundedCornerShape(style.shapes().control))
+                .padding(6.dp)
+        ) {
+            Box(
+                Modifier
+                    .fillMaxSize()
+                    .background(scheme.surface, RoundedCornerShape(style.shapes().control / 2))
+                    .padding(4.dp)
+            ) {
+                Box(
+                    Modifier
+                        .size(width = 22.dp, height = 8.dp)
+                        .background(scheme.primary, RoundedCornerShape(4.dp))
+                        .align(Alignment.BottomEnd)
+                )
+                Box(
+                    Modifier
+                        .size(width = 30.dp, height = 6.dp)
+                        .background(scheme.onSurface, RoundedCornerShape(3.dp))
+                        .align(Alignment.TopStart)
+                )
+            }
+        }
+    }
