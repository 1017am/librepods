+    along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+// NOTE: this file must stay free of android.* imports — it is compiled and unit-tested on the JVM.
+package me.kavishdevar.librepods.bluetooth.autoconnect
+
+/**
+ * Pure decision logic for automatic connection. It never touches Bluetooth itself; the
+ * Android-side [AutoConnectManager] feeds it events and executes the returned [Action]s.
+ *
+ * Behaviour (also documented in docs/fork/AUTO_CONNECT.md):
+ *  - Triggers are *edges*: lid closed→open, no bud in ear→a bud in ear, first sighting above
+ *    an RSSI threshold (opt-in), remote host disconnected while lid open/worn.
+ *  - Several of the user's own AirPods nearby: target = last connected identity, then the one
+ *    being worn, then lid open, then strongest RSSI. Only the target is ever connected; while
+ *    connected we never switch to a different pair automatically.
+ *  - Someone else's AirPods never pass IRK verification, so they never reach this class.
+ *  - Failure → retry with back-off [BACKOFF_MS] up to settings.maxAttempts, then FAILED until
+ *    the next edge trigger or a manual retry.
+ *  - User disconnect / another Apple device taking over → "paused": no automatic attempts
+ *    until a *new physical gesture* (lid re-opened or bud re-inserted) or the pair leaves range.
+ *  - Unexpected link loss while still worn / lid open → reconnect (counts as attempt 1).
+ */
+class AutoConnectController(
+    private val clock: () -> Long,
+    settings: AutoConnectSettings = AutoConnectSettings(),
+) {
+    sealed interface Action {
+        data object None : Action
+        data class Connect(
+            val target: Sighting?,
+            val trigger: Trigger,
+            val attempt: Int,
+            val delayMs: Long,
+        ) : Action
+        data object GiveUp : Action
+    }
+
+    @Volatile
+    var settings: AutoConnectSettings = settings
+        private set
+
+    var connected: Boolean = false
+        private set
+    var connecting: Boolean = false
+        private set
+    var attempt: Int = 0
+        private set
+    var paused: Boolean = false
+        private set
+    var lastConnectedIdentity: String? = null
+    private var lastAttemptAt: Long = Long.MIN_VALUE / 2
+    private var lastTrigger: Trigger = Trigger.MANUAL
+    private var lastTarget: Sighting? = null
+
+    fun updateSettings(newSettings: AutoConnectSettings) {
+        settings = newSettings.copy(maxAttempts = newSettings.maxAttempts.coerceIn(1, MAX_ATTEMPTS_CAP))
+    }
+
+    init {
+        updateSettings(settings)
+    }
+
+    // --------------------------------------------------------------------------------------
+    // Pure helpers (also used by the UI / tests)
+    // --------------------------------------------------------------------------------------
+
+    fun detectTrigger(prev: Sighting?, now: Sighting): Trigger? {
+        val s = settings
+        if (s.onLidOpen && now.lidOpen && (prev == null || !prev.lidOpen)) return Trigger.LID_OPENED
+        if (s.onInEar && now.anyInEar && (prev == null || !prev.anyInEar)) return Trigger.PUT_IN_EAR
+        if ((s.onLidOpen || s.onInEar) && prev != null &&
+            prev.remoteState != RemoteState.DISCONNECTED &&
+            now.remoteState == RemoteState.DISCONNECTED && now.active
+        ) return Trigger.REMOTE_DISCONNECTED
+        if (s.onNearby && prev == null && now.rssi >= s.nearbyRssiThreshold) return Trigger.NEARBY
+        return null
+    }
+
+    fun selectTarget(nearby: Collection<Sighting>, lastIdentity: String? = lastConnectedIdentity): Sighting? {
+        if (nearby.isEmpty()) return null
+        if (lastIdentity != null) {
+            nearby.filter { it.identityAddress.equals(lastIdentity, ignoreCase = true) }
+                .maxByOrNull { it.seenAtMillis }
+                ?.let { return it }
+        }
+        return nearby.sortedWith(
+            compareByDescending<Sighting> { it.anyInEar }
+                .thenByDescending { it.lidOpen }
+                .thenByDescending { it.rssi }
+                .thenByDescending { it.seenAtMillis }
+        ).first()
+    }
+
+    fun isBlockedByOtherHost(s: Sighting): Boolean =
+        settings.respectActiveOtherDevice && s.remoteState in RemoteState.ACTIVE
+
+    fun backoffFor(attempt: Int): Long =
+        BACKOFF_MS[(attempt - 1).coerceIn(0, BACKOFF_MS.lastIndex)]
+
+    // --------------------------------------------------------------------------------------
+    // Events
+    // --------------------------------------------------------------------------------------
+
+    /**
+     * @param prev previous sighting from the *same* RPA (null on first broadcast).
+     * @param nearby every fresh sighting of the user's own AirPods, including [now].
+     */
+    fun onSighting(prev: Sighting?, now: Sighting, nearby: Collection<Sighting>): Action {
+        if (!settings.enabled || connected || connecting) return Action.None
+        val trigger = detectTrigger(prev, now) ?: return Action.None
+
+        // A new deliberate gesture clears a user/other-device pause.
+        if (trigger == Trigger.LID_OPENED || trigger == Trigger.PUT_IN_EAR) paused = false
+        if (paused) return Action.None
+
+        val target = selectTarget(nearby) ?: now
+        if (target.rpa != now.rpa) return Action.None // another of our pairs is preferred
+        if (isBlockedByOtherHost(target)) return Action.None
+
+        val t = clock()
+        if (t - lastAttemptAt < MIN_TRIGGER_INTERVAL_MS) return Action.None
+
+        attempt = 1
+        return start(target, trigger, 0L)
+    }
+
+    fun onManualConnect(nearby: Collection<Sighting>): Action {
+        if (connected || connecting) return Action.None
+        paused = false
+        attempt = 1
+        return start(selectTarget(nearby), Trigger.MANUAL, 0L)
+    }
+
+    fun onConnectSucceeded(identityAddress: String?) {
+        connected = true
+        connecting = false
+        attempt = 0
+        if (identityAddress != null) lastConnectedIdentity = identityAddress
+    }
+
+    /** Connect was not executed at all (no permission, adapter off …). */
+    fun onConnectAborted() {
+        connecting = false
+    }
+
+    fun onConnectFailed(): Action {
+        connecting = false
+        if (attempt >= settings.maxAttempts) {
+            return Action.GiveUp
+        }
+        attempt += 1
+        return start(lastTarget, lastTrigger, backoffFor(attempt))
+    }
+
+    /**
+     * @param stillActive a sighting of the connected pair younger than ~15 s shows lid open / worn.
+     */
+    fun onDisconnected(userInitiated: Boolean, stillActive: Boolean): Action {
+        if (!connected && !connecting) return Action.None
+        connected = false
+        connecting = false
+        if (userInitiated) {
+            paused = true
+            return Action.None
+        }
+        if (paused || !settings.enabled || !settings.reconnectOnLinkLoss || !stillActive) return Action.None
+        attempt = 1
+        return start(lastTarget, Trigger.UNEXPECTED_DISCONNECT, LINK_LOSS_DELAY_MS)
+    }
+
+    fun onOtherDeviceTookOver() {
+        paused = true
+    }
+
+    fun clearPause() {
+        paused = false
+    }
+
+    /** All of the user's AirPods left BLE range (e.g. case closed and put away). */
+    fun onAllDisappeared() {
+        paused = false
+        if (!connected) {
+            connecting = false
+            attempt = 0
+        }
+    }
+
+    private fun start(target: Sighting?, trigger: Trigger, delayMs: Long): Action {
+        connecting = true
+        lastAttemptAt = clock() + delayMs
+        lastTrigger = trigger
+        lastTarget = target
+        return Action.Connect(target, trigger, attempt, delayMs)
+    }
+
+    companion object {
+        val BACKOFF_MS = longArrayOf(0L, 3_000L, 8_000L, 20_000L, 45_000L, 60_000L)
+        const val MIN_TRIGGER_INTERVAL_MS = 10_000L
+        const val LINK_LOSS_DELAY_MS = 2_000L
+        const val SIGHTING_FRESH_MS = 15_000L
+        const val MAX_ATTEMPTS_CAP = 8
+    }
+}
