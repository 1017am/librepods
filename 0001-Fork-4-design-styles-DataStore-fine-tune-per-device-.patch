diff --git a/android/tools/contrast.py b/android/tools/contrast.py
new file mode 100644
index 0000000..538c7c6
--- /dev/null
+++ b/android/tools/contrast.py
@@ -0,0 +1,41 @@
+import itertools, sys
+def lin(c):
+    c/=255; return c/12.92 if c<=0.03928 else ((c+0.055)/1.055)**2.4
+def L(h):
+    h=h.lstrip('#'); r,g,b=[int(h[i:i+2],16) for i in (0,2,4)]
+    return 0.2126*lin(r)+0.7152*lin(g)+0.0722*lin(b)
+def blend(fg,bg,a):
+    f=[int(fg.lstrip('#')[i:i+2],16) for i in (0,2,4)]; b=[int(bg.lstrip('#')[i:i+2],16) for i in (0,2,4)]
+    return '#'+''.join('%02X'%round(a*x+(1-a)*y) for x,y in zip(f,b))
+def cr(a,b):
+    la,lb=L(a),L(b); hi,lo=max(la,lb),min(la,lb); return (hi+0.05)/(lo+0.05)
+P = {
+ 'TOSS_L': dict(primary='#1B64DA',onPrimary='#FFFFFF',bg='#F2F4F6',surface='#FFFFFF',onSurface='#191F28',onSurfaceVariant='#4E5968',secC='#E8F3FF',onSecC='#1957C2',outline='#8B95A1',error='#D22030'),
+ 'TOSS_D': dict(primary='#64A8FF',onPrimary='#00142E',bg='#101013',surface='#202027',onSurface='#F2F4F6',onSurfaceVariant='#B0B8C1',secC='#1D3A66',onSecC='#C9E2FF',outline='#7E8A97',error='#FF8A8A'),
+ 'APPLE_L': dict(primary='#0066CC',onPrimary='#FFFFFF',bg='#F2F2F7',surface='#FFFFFF',onSurface='#000000',onSurfaceVariant='#5A5A60',secC='#D6E8FF',onSecC='#004C99',outline='#8E8E93',error='#C4161C'),
+ 'APPLE_D': dict(primary='#4DA3FF',onPrimary='#001A33',bg='#000000',surface='#1C1C1E',onSurface='#FFFFFF',onSurfaceVariant='#AEAEB2',secC='#0A3A6B',onSecC='#CFE5FF',outline='#8E8E93',error='#FF6961'),
+ 'SAMSUNG_L': dict(primary='#005FC5',onPrimary='#FFFFFF',bg='#F4F4F4',surface='#FFFFFF',onSurface='#111111',onSurfaceVariant='#555555',secC='#DDE8FB',onSecC='#00429A',outline='#8A8A8A',error='#C62828'),
+ 'SAMSUNG_D': dict(primary='#6FA8FF',onPrimary='#001736',bg='#000000',surface='#171717',onSurface='#FAFAFA',onSurfaceVariant='#B5B5B5',secC='#13305E',onSecC='#D3E3FF',outline='#8A8A8A',error='#FF7B72'),
+ 'APPLE_ORIG_L': dict(primary='#0088FF',onPrimary='#FFFFFF',bg='#F2F2F7',surface='#FFFFFF',onSurface='#000000',onSurfaceVariant='#000000',secC='#6BC0FF',onSecC='#0088FF',outline='#8E8E93',error='#B3261E'),
+}
+fails=0
+for name,p in P.items():
+    checks = [
+     ('onSurface/surface',p['onSurface'],p['surface'],4.5),
+     ('onSurface/bg',p['onSurface'],p['bg'],4.5),
+     ('onSurfaceVariant/surface',p['onSurfaceVariant'],p['surface'],4.5),
+     ('primary(text)/surface',p['primary'],p['surface'],4.5),
+     ('primary(text)/bg',p['primary'],p['bg'],4.5),
+     ('onPrimary/primary',p['onPrimary'],p['primary'],4.5),
+     ('onSecC/secC',p['onSecC'],p['secC'],4.5),
+     ('error/surface',p['error'],p['surface'],4.5),
+     ('outline/surface (UI 3:1)',p['outline'],p['surface'],3.0),
+     ('sectionHeader a0.72/bg',blend(p['onSurface'],p['bg'],0.72),p['bg'],4.5),
+     ('sectionHeader a0.60/bg (upstream)',blend(p['onSurface'],p['bg'],0.60),p['bg'],4.5),
+    ]
+    for label,fg,bg,need in checks:
+        r=cr(fg,bg); ok=r>=need
+        if not ok and not name.startswith('APPLE_ORIG') and 'upstream' not in label: fails+=1
+        print(f"{name:12s} {label:34s} {r:5.2f} {'OK' if ok else 'FAIL'} (>= {need})")
+print('FAILURES (new palettes):',fails)
+sys.exit(1 if fails else 0)
