+package me.kavishdevar.librepods.companion
+
+import android.companion.AssociationInfo
+import android.companion.AssociationRequest
+import android.companion.BluetoothDeviceFilter
+import android.companion.CompanionDeviceManager
+import android.content.Context
+import android.content.IntentSender
+import android.content.pm.PackageManager
+import android.util.Log
+
+/**
+ * Thin wrapper around CompanionDeviceManager (API 33+, the app's minSdk).
+ * The association dialog is shown by the system; we filter on the AirPods' saved classic MAC.
+ */
+object CompanionAssociation {
+    private const val TAG = "AirPodsCDM"
+
+    fun isSupported(context: Context): Boolean =
+        context.packageManager.hasSystemFeature(PackageManager.FEATURE_COMPANION_DEVICE_SETUP)
+
+    private fun cdm(context: Context): CompanionDeviceManager? =
+        context.getSystemService(CompanionDeviceManager::class.java)
+
+    fun associations(context: Context): List<AssociationInfo> =
+        try {
+            cdm(context)?.myAssociations ?: emptyList()
+        } catch (e: Exception) {
+            Log.w(TAG, "myAssociations failed: ${e.message}")
+            emptyList()
+        }
+
+    fun isAssociated(context: Context, mac: String?): Boolean {
+        if (mac.isNullOrBlank()) return false
+        return associations(context).any { it.deviceMacAddress?.toString().equals(mac, ignoreCase = true) }
+    }
+
+    /**
+     * Starts the system association flow. [onPending] receives the IntentSender for the system
+     * dialog (launch it with ActivityResultContracts.StartIntentSenderForResult).
+     */
+    fun associate(
+        context: Context,
+        mac: String,
+        onPending: (IntentSender) -> Unit,
+        onCreated: (AssociationInfo) -> Unit,
+        onFailed: (CharSequence?) -> Unit,
+    ) {
+        val manager = cdm(context) ?: return onFailed("CompanionDeviceManager unavailable")
+        val request = AssociationRequest.Builder()
+            .addDeviceFilter(BluetoothDeviceFilter.Builder().setAddress(mac).build())
+            .setSingleDevice(true)
+            .build()
+        manager.associate(request, context.mainExecutor, object : CompanionDeviceManager.Callback() {
+            override fun onAssociationPending(intentSender: IntentSender) {
+                onPending(intentSender)
+            }
+
+            override fun onAssociationCreated(associationInfo: AssociationInfo) {
+                startObserving(context, mac)
+                onCreated(associationInfo)
+            }
+
+            override fun onFailure(error: CharSequence?) {
+                onFailed(error)
+            }
+        })
+    }
+
+    /** Asks the system to bind AirPodsCompanionService when the device connects. */
+    @Suppress("DEPRECATION") // ObservingDevicePresenceRequest is API 36+; the MAC variant still works.
+    fun startObserving(context: Context, mac: String): Boolean =
+        try {
+            cdm(context)?.startObservingDevicePresence(mac)
+            true
+        } catch (e: Exception) {
+            Log.w(TAG, "startObservingDevicePresence failed: ${e.message}")
+            false
+        }
+
+    fun disassociate(context: Context, mac: String) {
+        val manager = cdm(context) ?: return
+        associations(context)
+            .filter { it.deviceMacAddress?.toString().equals(mac, ignoreCase = true) }
+            .forEach {
+                try {
+                    @Suppress("DEPRECATION")
+                    manager.stopObservingDevicePresence(mac)
+                } catch (_: Exception) {
+                }
+                manager.disassociate(it.id)
+            }
+    }
+}
