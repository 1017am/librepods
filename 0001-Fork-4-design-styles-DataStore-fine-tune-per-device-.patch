+    val topPadding = if (m3eEnabled) 0.dp else WindowInsets.statusBars.asPaddingValues().calculateTopPadding() + 84.dp
+    val bottomPadding = if (m3eEnabled) 16.dp else WindowInsets.navigationBars.asPaddingValues().calculateBottomPadding() + 16.dp
+
+    var nameDialog by remember { mutableStateOf<NameDialog?>(null) }
+    var deleteDialog by remember { mutableStateOf<Pair<String, () -> Unit>?>(null) }
+
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.surfaceContainer)
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(20.dp)
+    ) {
+        Spacer(Modifier.height(topPadding))
+
+        // ---- Support overview -------------------------------------------------------------
+        ForkSection(title = stringResource(R.string.fork_support_title)) {
+            Feature.entries.forEach { f ->
+                val r = reason(f)
+                ForkInfoRow(
+                    label = featureLabel(f),
+                    value = r?.let { reasonText(it) } ?: stringResource(R.string.fork_available),
+                    valueIsProblem = r != null
+                )
+            }
+        }
+
+        // ---- Precise sliders --------------------------------------------------------------
+        ForkSection(title = stringResource(R.string.fork_fine_tune)) {
+            // Adaptive audio strength: UI value = 100 - device byte (same mapping as upstream).
+            val strengthDevice = state.controlStates[ControlCommandIdentifiers.AUTO_ANC_STRENGTH]
+                ?.getOrNull(0)?.toInt()?.and(0xFF)
+            var strength by remember { mutableIntStateOf(100 - (strengthDevice ?: 50).coerceIn(0, 100)) }
+            LaunchedEffect(strengthDevice) { if (strengthDevice != null) strength = 100 - strengthDevice.coerceIn(0, 100) }
+            val sendStrength = rememberDebounced(150)
+            PreciseSlider(
+                label = stringResource(R.string.fork_adaptive_strength),
+                value = strength,
+                range = 0..100,
+                endsText = stringResource(R.string.fork_adaptive_strength_ends),
+                disabledReason = reason(Feature.ADAPTIVE_STRENGTH)?.let { reasonText(it) },
+                onValueChange = { v ->
+                    strength = v
+                    sendStrength {
+                        viewModel.setControlCommandValue(
+                            ControlCommandIdentifiers.AUTO_ANC_STRENGTH, byteArrayOf((100 - v).toByte())
+                        )
+                    }
+                }
+            )
+
+            // Tone (chime) volume: [volume, 0x50] like upstream AccessibilitySettingsScreen.
+            val chimeDevice = state.controlStates[ControlCommandIdentifiers.CHIME_VOLUME]
+                ?.getOrNull(0)?.toInt()?.and(0xFF)
+            var chime by remember { mutableIntStateOf((chimeDevice ?: 75).coerceIn(0, 100)) }
+            LaunchedEffect(chimeDevice) { if (chimeDevice != null) chime = chimeDevice.coerceIn(0, 100) }
+            val sendChime = rememberDebounced(150)
+            PreciseSlider(
+                label = stringResource(R.string.fork_chime_volume),
+                value = chime,
+                range = 0..100,
+                valueText = { "$it%" },
+                disabledReason = reason(Feature.CHIME_VOLUME)?.let { reasonText(it) },
+                onValueChange = { v ->
+                    chime = v
+                    sendChime {
+                        viewModel.setControlCommandValue(
+                            ControlCommandIdentifiers.CHIME_VOLUME, byteArrayOf(v.toByte(), 0x50)
+                        )
+                    }
+                }
+            )
+        }
+
+        // ---- Custom EQ + presets ----------------------------------------------------------
+        val eqReason = reason(Feature.CUSTOM_EQ)?.let { reasonText(it) }
+        ForkSection(
+            title = stringResource(R.string.fork_custom_eq),
+            description = stringResource(R.string.fork_ten_band_note)
+        ) {
+            val eq = state.customEq
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_eq_enabled),
+                checked = eq.isEnabled(),
+                onCheckedChange = viewModel::setCustomEqEnabled,
+                disabledReason = eqReason
+            )
+            var low by remember { mutableIntStateOf(eq.low) }
+            var mid by remember { mutableIntStateOf(eq.mid) }
+            var high by remember { mutableIntStateOf(eq.high) }
+            LaunchedEffect(eq.low, eq.mid, eq.high) { low = eq.low; mid = eq.mid; high = eq.high }
+            val sendEq = rememberDebounced(200)
+            val bandReason = eqReason
+            val push = { sendEq { viewModel.setCustomEq(low, mid, high) } }
+            PreciseSlider(stringResource(R.string.fork_eq_low), low, 0..100, { low = it; push() }, disabledReason = bandReason)
+            PreciseSlider(stringResource(R.string.fork_eq_mid), mid, 0..100, { mid = it; push() }, disabledReason = bandReason)
+            PreciseSlider(stringResource(R.string.fork_eq_high), high, 0..100, { high = it; push() }, disabledReason = bandReason)
+        }
+
+        ForkSection(title = stringResource(R.string.fork_eq_presets)) {
+            if (presets.isEmpty()) {
+                ForkInfoRow(stringResource(R.string.fork_eq_presets), stringResource(R.string.fork_eq_no_presets))
+            }
+            presets.forEach { p ->
+                ForkInfoRow(label = p.name, value = "L ${p.low} · M ${p.mid} · H ${p.high}") {
+                    Row {
+                        TextButton(onClick = { viewModel.applyEqPreset(p) }, enabled = eqReason == null) {
+                            Text(stringResource(R.string.fork_apply))
+                        }
+                        TextButton(onClick = {
+                            deleteDialog = p.name to { scope.launch { repo.deleteEqPreset(mac, p.id) }; Unit }
+                        }) { Text(stringResource(R.string.fork_delete)) }
+                    }
+                }
+            }
+            TextButton(
+                onClick = {
+                    nameDialog = NameDialog { name ->
+                        scope.launch {
+                            repo.saveEqPreset(mac, EqPreset(name = name, low = state.customEq.low, mid = state.customEq.mid, high = state.customEq.high))
+                        }
+                    }
+                },
+                enabled = eqReason == null,
+                modifier = Modifier.padding(horizontal = 8.dp).heightIn(min = MinTouchTarget)
+            ) { Text(stringResource(R.string.fork_save_current)) }
+        }
+
+        // ---- Per-device profiles ----------------------------------------------------------
+        ForkSection(
+            title = stringResource(R.string.fork_profiles),
+            description = stringResource(R.string.fork_profiles_desc)
+        ) {
+            if (profiles.isEmpty()) {
+                ForkInfoRow(stringResource(R.string.fork_profiles), stringResource(R.string.fork_no_profiles))
+            }
+            profiles.forEach { p ->
+                ForkInfoRow(
+                    label = p.name,
+                    value = stringResource(R.string.fork_profile_settings_count, p.controls.size + (if (p.eq != null) 1 else 0))
+                ) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        val appliedFmt = stringResource(R.string.fork_profile_applied)
+                        TextButton(
+                            onClick = {
+                                val r = viewModel.applyProfile(p)
+                                val shownSkips = r.skipped.filterValues { it != SkipReason.ALREADY_EQUAL }
+                                Toast.makeText(context, String.format(appliedFmt, r.applied.size, shownSkips.size), Toast.LENGTH_LONG).show()
+                            },
+                            enabled = state.isLocallyConnected
+                        ) { Text(stringResource(R.string.fork_apply)) }
+                        TextButton(onClick = {
+                            deleteDialog = p.name to { scope.launch { repo.deleteProfile(mac, p.id) }; Unit }
+                        }) { Text(stringResource(R.string.fork_delete)) }
+                    }
+                }
+            }
+            TextButton(
+                onClick = {
+                    nameDialog = NameDialog { name ->
+                        val profile: DeviceProfile = viewModel.captureProfile(name)
+                        scope.launch { repo.saveProfile(mac, profile) }
+                    }
+                },
+                enabled = state.isLocallyConnected,
+                modifier = Modifier.padding(horizontal = 8.dp).heightIn(min = MinTouchTarget)
+            ) { Text(stringResource(R.string.fork_save_current)) }
+        }
+
+        Spacer(Modifier.height(bottomPadding))
+    }
+
+    nameDialog?.let { dlg ->
+        var text by remember { mutableStateOf("") }
+        AlertDialog(
+            onDismissRequest = { nameDialog = null },
+            confirmButton = {
+                TextButton(enabled = text.isNotBlank(), onClick = {
+                    dlg.onConfirm(text.trim().take(40)); nameDialog = null
+                }) { Text(stringResource(R.string.fork_save)) }
+            },
+            dismissButton = { TextButton(onClick = { nameDialog = null }) { Text(stringResource(R.string.fork_cancel)) } },
+            title = { Text(stringResource(R.string.fork_save_current)) },
+            text = {
+                OutlinedTextField(
+                    value = text,
+                    onValueChange = { text = it },
+                    singleLine = true,
+                    label = { Text(stringResource(R.string.fork_name_hint)) },
+                    modifier = Modifier.fillMaxWidth()
+                )
+            }
+        )
+    }
+
+    deleteDialog?.let { (name, action) ->
+        AlertDialog(
+            onDismissRequest = { deleteDialog = null },
+            confirmButton = {
+                TextButton(onClick = { action(); deleteDialog = null }) {
+                    Text(stringResource(R.string.fork_delete), color = MaterialTheme.colorScheme.error)
+                }
+            },
+            dismissButton = { TextButton(onClick = { deleteDialog = null }) { Text(stringResource(R.string.fork_cancel)) } },
+            text = { Text(stringResource(R.string.fork_delete_confirm, name)) }
+        )
+    }
+}
+
+private class NameDialog(val onConfirm: (String) -> Unit)
+
+/** Returns a function that runs the last submitted block after [delayMs] of inactivity. */
+@Composable
+private fun rememberDebounced(delayMs: Long): ((() -> Unit) -> Unit) {
+    val scope = rememberCoroutineScope()
+    val holder = remember { arrayOfNulls<Job>(1) }
+    return remember(scope) {
+        { block: () -> Unit ->
+            holder[0]?.cancel()
+            holder[0] = scope.launch {
+                delay(delayMs)
+                block()
+            }
+        }
+    }
+}
+
+@Composable
+fun reasonText(r: UnsupportedReason): String = stringResource(
+    when (r) {
+        UnsupportedReason.NOT_CONNECTED -> R.string.fork_reason_not_connected
+        UnsupportedReason.MODEL_LACKS -> R.string.fork_reason_model_lacks
+        UnsupportedReason.NEEDS_VENDOR_ID_HOOK -> R.string.fork_reason_vendor_hook
+        UnsupportedReason.NOT_REPORTED_BY_DEVICE -> R.string.fork_reason_not_reported
+        UnsupportedReason.MODEL_UNKNOWN -> R.string.fork_reason_model_unknown
+        UnsupportedReason.NEEDS_PREMIUM -> R.string.fork_reason_premium
+    }
+)
