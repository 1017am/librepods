+import me.kavishdevar.librepods.bluetooth.autoconnect.FailureReason
+import me.kavishdevar.librepods.presentation.theme.LocalStyleShapes
+
+/**
+ * Home-screen header: device name + connection phase + L/R/case battery.
+ * Data comes from [AutoConnectState] (live, written by the service) — no placeholder values:
+ * unknown battery is shown as "–", and the battery source is always labelled.
+ */
+@Composable
+fun ConnectionStatusCard(
+    modifier: Modifier = Modifier,
+    fallbackName: String,
+    onOpenAutoConnectSettings: () -> Unit,
+) {
+    val status by AutoConnectState.status.collectAsState()
+    ConnectionStatusCardContent(
+        status = status,
+        fallbackName = fallbackName,
+        modifier = modifier,
+        onConnectNow = { AutoConnectState.manager?.connectNow() },
+        onResume = { AutoConnectState.manager?.resume() },
+        onOpenAutoConnectSettings = onOpenAutoConnectSettings,
+    )
+}
+
+@Composable
+fun ConnectionStatusCardContent(
+    status: ConnectionStatus,
+    fallbackName: String,
+    modifier: Modifier = Modifier,
+    onConnectNow: () -> Unit,
+    onResume: () -> Unit,
+    onOpenAutoConnectSettings: () -> Unit,
+) {
+    val context = LocalContext.current
+    val name = status.deviceName?.takeIf { it.isNotBlank() } ?: fallbackName
+    val phaseText = phaseText(status)
+    val (dotColor, dotSymbol) = phaseIndicator(status.phase)
+
+    Surface(
+        shape = RoundedCornerShape(LocalStyleShapes.current.card),
+        color = MaterialTheme.colorScheme.surface,
+        contentColor = MaterialTheme.colorScheme.onSurface,
+        modifier = modifier.fillMaxWidth()
+    ) {
+        Column(Modifier.padding(16.dp)) {
+            // Name + phase (announced politely by TalkBack when it changes)
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .semantics(mergeDescendants = true) { liveRegion = LiveRegionMode.Polite }
+            ) {
+                Column(Modifier.weight(1f)) {
+                    Text(
+                        name,
+                        style = MaterialTheme.typography.titleLarge,
+                        fontWeight = FontWeight.SemiBold,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis
+                    )
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        // Colour + symbol + text: state is never conveyed by colour alone.
+                        Box(
+                            Modifier
+                                .size(10.dp)
+                                .background(dotColor, CircleShape)
+                        )
+                        Spacer(Modifier.width(6.dp))
+                        Text(
+                            "$dotSymbol $phaseText",
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant
+                        )
+                    }
+                }
+            }
+
+            val chips = buildList {
+                if (status.lidOpen) add(stringResource(R.string.fork_status_lid_open))
+                if (status.leftInEar || status.rightInEar) add(stringResource(R.string.fork_status_in_ear))
+                if (status.otherOwnDevicesNearby > 0) add(stringResource(R.string.fork_status_other_nearby, status.otherOwnDevicesNearby))
+            }
+            if (chips.isNotEmpty()) {
+                Spacer(Modifier.height(6.dp))
+                Text(
+                    chips.joinToString(" · "),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant
+                )
+            }
+
+            status.battery?.let { battery ->
+                Spacer(Modifier.height(12.dp))
+                BatteryRow(battery)
+            }
+
+            phaseDetail(status)?.let { detail ->
+                Spacer(Modifier.height(8.dp))
+                Text(
+                    detail,
+                    style = MaterialTheme.typography.bodySmall,
+                    color = if (status.phase == ConnectionPhase.FAILED) MaterialTheme.colorScheme.error
+                    else MaterialTheme.colorScheme.onSurfaceVariant
+                )
+            }
+
+            val primaryAction: Pair<String, () -> Unit>? = when (status.phase) {
+                ConnectionPhase.NEARBY, ConnectionPhase.IN_USE_ELSEWHERE ->
+                    stringResource(R.string.fork_action_connect_now) to onConnectNow
+                ConnectionPhase.FAILED -> stringResource(R.string.fork_action_retry) to onConnectNow
+                ConnectionPhase.PAUSED -> stringResource(R.string.fork_action_resume) to onResume
+                ConnectionPhase.MISSING_PERMISSION -> stringResource(R.string.fork_action_grant) to onOpenAutoConnectSettings
+                ConnectionPhase.BLUETOOTH_OFF -> stringResource(R.string.fork_action_turn_on_bt) to {
+                    try {
+                        context.startActivity(
+                            Intent(BluetoothAdapter.ACTION_REQUEST_ENABLE).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                        )
+                    } catch (_: Exception) {
+                    }
+                }
+                else -> null
+            }
+            Spacer(Modifier.height(12.dp))
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.fillMaxWidth()) {
+                if (primaryAction != null) {
+                    Button(
+                        onClick = primaryAction.second,
+                        modifier = Modifier.heightIn(min = MinTouchTarget)
+                    ) { Text(primaryAction.first) }
+                }
+                OutlinedButton(
+                    onClick = onOpenAutoConnectSettings,
+                    modifier = Modifier.heightIn(min = MinTouchTarget)
+                ) { Text(stringResource(R.string.fork_auto_connect)) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun BatteryRow(battery: BatterySnapshot) {
+    Row(horizontalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.fillMaxWidth()) {
+        BatteryCell(stringResource(R.string.fork_battery_left), battery.left, Modifier.weight(1f))
+        BatteryCell(stringResource(R.string.fork_battery_right), battery.right, Modifier.weight(1f))
+        BatteryCell(stringResource(R.string.fork_battery_case), battery.case, Modifier.weight(1f))
+    }
+    Spacer(Modifier.height(6.dp))
+    Text(
+        stringResource(
+            when (battery.source) {
+                BatterySource.AACP -> R.string.fork_battery_source_aacp
+                BatterySource.BLE_DECRYPTED -> R.string.fork_battery_source_ble_dec
+                BatterySource.BLE_ESTIMATE -> R.string.fork_battery_source_ble
+            }
+        ),
+        style = MaterialTheme.typography.bodySmall,
+        color = MaterialTheme.colorScheme.onSurfaceVariant
+    )
+}
+
+@Composable
+private fun BatteryCell(label: String, bud: BudBattery, modifier: Modifier) {
+    val unknown = stringResource(R.string.fork_battery_unknown)
+    val charging = stringResource(R.string.fork_battery_charging)
+    val value = bud.level?.let { "$it%" } ?: unknown
+    val description = buildString {
+        append(label).append(": ").append(value)
+        if (bud.charging) append(", ").append(charging)
+    }
+    Surface(
+        shape = RoundedCornerShape(LocalStyleShapes.current.control),
+        color = MaterialTheme.colorScheme.surfaceContainer,
+        modifier = modifier.clearAndSetSemantics { contentDescription = description }
+    ) {
+        Column(Modifier.padding(horizontal = 12.dp, vertical = 10.dp)) {
+            Text(label, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+            Text(
+                if (bud.charging) "⚡ $value" else value,
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.SemiBold
+            )
+        }
+    }
+}
+
+@Composable
+private fun phaseText(status: ConnectionStatus): String = when (status.phase) {
+    ConnectionPhase.IDLE -> stringResource(R.string.fork_status_idle)
+    ConnectionPhase.MISSING_PERMISSION -> stringResource(R.string.fork_status_missing_permission)
+    ConnectionPhase.BLUETOOTH_OFF -> stringResource(R.string.fork_status_bluetooth_off)
+    ConnectionPhase.NO_PAIRED_DEVICE -> stringResource(R.string.fork_status_no_paired)
+    ConnectionPhase.NO_PROXIMITY_KEYS -> stringResource(R.string.fork_status_no_keys)
+    ConnectionPhase.PAUSED -> stringResource(R.string.fork_status_paused)
+    ConnectionPhase.SEARCHING -> stringResource(R.string.fork_status_searching)
+    ConnectionPhase.NEARBY -> stringResource(R.string.fork_status_nearby)
+    ConnectionPhase.IN_USE_ELSEWHERE -> stringResource(R.string.fork_status_in_use_elsewhere)
+    ConnectionPhase.CONNECTING ->
+        if (status.attempt > 1) stringResource(R.string.fork_status_connecting_attempt, status.attempt, status.maxAttempts)
+        else stringResource(R.string.fork_status_connecting)
+    ConnectionPhase.CONNECTED -> stringResource(R.string.fork_status_connected)
+    ConnectionPhase.FAILED -> stringResource(R.string.fork_status_failed)
+}
+
+@Composable
+private fun phaseDetail(status: ConnectionStatus): String? {
+    val retryAt = status.nextRetryAtMillis
+    if (status.phase == ConnectionPhase.CONNECTING && retryAt != null) {
+        var now by remember { mutableLongStateOf(System.currentTimeMillis()) }
+        LaunchedEffect(retryAt) {
+            while (System.currentTimeMillis() < retryAt) {
+                now = System.currentTimeMillis()
+                delay(500)
+            }
+        }
+        val seconds = ((retryAt - now + 999) / 1000).coerceAtLeast(0).toInt()
+        return stringResource(R.string.fork_status_retry_in, seconds)
+    }
+    return when (status.phase) {
+        ConnectionPhase.PAUSED -> stringResource(R.string.fork_status_paused_desc)
+        ConnectionPhase.NO_PROXIMITY_KEYS -> stringResource(R.string.fork_status_no_keys_desc)
+        ConnectionPhase.FAILED -> when (status.failure) {
+            FailureReason.SOCKET_TIMEOUT -> stringResource(R.string.fork_failure_timeout)
+            FailureReason.SOCKET_ERROR -> stringResource(R.string.fork_failure_socket, status.failureDetail ?: "?")
+            FailureReason.L2CAP_UNAVAILABLE -> stringResource(R.string.fork_failure_l2cap)
+            FailureReason.NOT_BONDED -> stringResource(R.string.fork_failure_not_bonded)
+            FailureReason.BLUETOOTH_OFF -> stringResource(R.string.fork_failure_bt_off)
+            FailureReason.PERMISSION -> stringResource(R.string.fork_failure_permission)
+            FailureReason.UNKNOWN, null -> stringResource(R.string.fork_failure_unknown)
+        }
+        ConnectionPhase.CONNECTED ->
+            if (!status.canConnectAudioProfiles) stringResource(R.string.fork_status_no_audio_profiles) else null
+        else -> null
+    }
+}
+
+/** Colour + a text symbol so the state is distinguishable without colour vision. */
+@Composable
+private fun phaseIndicator(phase: ConnectionPhase): Pair<Color, String> {
+    val cs = MaterialTheme.colorScheme
+    return when (phase) {
+        ConnectionPhase.CONNECTED -> Color(0xFF1E8E3E) to "●"
+        ConnectionPhase.CONNECTING, ConnectionPhase.SEARCHING -> cs.primary to "◌"
+        ConnectionPhase.NEARBY -> cs.primary to "◉"
+        ConnectionPhase.FAILED, ConnectionPhase.MISSING_PERMISSION, ConnectionPhase.BLUETOOTH_OFF -> cs.error to "!"
+        else -> cs.outline to "○"
+    }
+}
