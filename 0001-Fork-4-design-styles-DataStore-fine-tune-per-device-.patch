+    along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+package me.kavishdevar.librepods.utils
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.PowerManager
+import android.provider.Settings
+import androidx.core.net.toUri
+import me.kavishdevar.librepods.BuildConfig
+
+/**
+ * Permission matrix for auto-connect. The app's minSdk is 33 (Android 13), so the Android 12
+ * branch only matters if someone lowers minSdk; it is kept for correctness.
+ *
+ * | Android | What we need                                                                      |
+ * |---------|-----------------------------------------------------------------------------------|
+ * | 12 (31) | BLUETOOTH_SCAN (neverForLocation) + BLUETOOTH_CONNECT. No location permission.    |
+ * | 13 (33) | + POST_NOTIFICATIONS for the foreground-service / status notification.            |
+ * | 14 (34) | connectedDevice FGS requires one of BLUETOOTH_CONNECT/SCAN/ADVERTISE *granted*     |
+ * |         | before startForeground(), else SecurityException → we check before starting.     |
+ * | 15+     | BOOT_COMPLETED may still start connectedDevice FGS (only dataSync, camera, etc.  |
+ * |         | are blocked). Background FGS starts need an exemption: CDM association or       |
+ * |         | battery-optimisation exemption.                                                   |
+ *
+ * Location: never needed because BLUETOOTH_SCAN is declared with neverForLocation; the AirPods
+ * proximity broadcast is not a beacon format that gets filtered by that flag.
+ */
+object AutoConnectPermissions {
+
+    fun runtimePermissions(): List<String> = buildList {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            add(Manifest.permission.BLUETOOTH_SCAN)
+            add(Manifest.permission.BLUETOOTH_CONNECT)
+        } else {
+            add(Manifest.permission.ACCESS_FINE_LOCATION)
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            add(Manifest.permission.POST_NOTIFICATIONS)
+        }
+    }
+
+    fun isGranted(context: Context, permission: String): Boolean =
+        context.checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED
+
+    fun missing(context: Context): List<String> = runtimePermissions().filterNot { isGranted(context, it) }
+
+    fun hasScanAndConnect(context: Context): Boolean =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            isGranted(context, Manifest.permission.BLUETOOTH_SCAN) &&
+                isGranted(context, Manifest.permission.BLUETOOTH_CONNECT)
+        } else {
+            isGranted(context, Manifest.permission.ACCESS_FINE_LOCATION)
+        }
+
+    /** Android 14+: prerequisite for startForeground(type = connectedDevice). */
+    fun canStartConnectedDeviceFgs(context: Context): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return true
+        return listOf(
+            Manifest.permission.BLUETOOTH_CONNECT,
+            Manifest.permission.BLUETOOTH_SCAN,
+            Manifest.permission.BLUETOOTH_ADVERTISE
+        ).any { isGranted(context, it) }
+    }
+
+    /** BLUETOOTH_PRIVILEGED is only granted to system/priv-apps (root module). */
+    fun hasPrivilegedBluetooth(context: Context): Boolean =
+        isGranted(context, "android.permission.BLUETOOTH_PRIVILEGED")
+
+    fun isIgnoringBatteryOptimizations(context: Context): Boolean {
+        val pm = context.getSystemService(PowerManager::class.java) ?: return false
+        return pm.isIgnoringBatteryOptimizations(context.packageName)
+    }
+
+    /**
+     * FOSS: direct "allow" dialog (needs REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, declared only in
+     * src/foss/AndroidManifest.xml because Play policy restricts it).
+     * Play: opens the system list so the user can do it manually.
+     */
+    @SuppressLint("BatteryLife")
+    fun batteryOptimizationIntent(context: Context): Intent =
+        if (!BuildConfig.PLAY_BUILD) {
+            Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, "package:${context.packageName}".toUri())
+        } else {
+            Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS)
+        }
+
+    fun appDetailsIntent(context: Context): Intent =
+        Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, "package:${context.packageName}".toUri())
+}
