+    Feature.LONG_PRESS_MODES -> stringResource(R.string.press_and_hold_airpods)
+    Feature.ONE_BUD_ANC -> stringResource(R.string.noise_cancellation_single_airpod)
+    Feature.CONVERSATION_AWARENESS -> stringResource(R.string.conversation_awareness)
+    Feature.ADAPTIVE_STRENGTH -> stringResource(R.string.fork_adaptive_strength)
+    Feature.ADAPTIVE_VOLUME -> stringResource(R.string.personalized_volume)
+    Feature.CUSTOM_EQ -> stringResource(R.string.equalizer)
+    Feature.STEM_ACTIONS -> stringResource(R.string.press_and_hold_airpods)
+    Feature.HEAD_GESTURES -> stringResource(R.string.head_gestures)
+    Feature.CHIME_VOLUME -> stringResource(R.string.fork_chime_volume)
+    Feature.SLEEP_DETECTION -> stringResource(R.string.sleep_detection)
+    Feature.VOLUME_SWIPE -> stringResource(R.string.volume_control)
+    Feature.LOUD_SOUND_REDUCTION -> stringResource(R.string.loud_sound_reduction)
+    Feature.HEARING_AID -> stringResource(R.string.hearing_aid)
+    Feature.TRANSPARENCY_CUSTOMIZATION -> stringResource(R.string.customize_transparency_mode)
