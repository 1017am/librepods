+package me.kavishdevar.librepods.data.prefs
+
+import android.content.Context
+import androidx.core.content.edit
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.emptyPreferences
+import androidx.datastore.preferences.core.floatPreferencesKey
+import androidx.datastore.preferences.core.stringPreferencesKey
+import androidx.datastore.preferences.preferencesDataStore
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import me.kavishdevar.librepods.presentation.theme.AppStyle
+import me.kavishdevar.librepods.presentation.theme.MAX_FONT_SCALE
+import me.kavishdevar.librepods.presentation.theme.MIN_FONT_SCALE
+import java.io.IOException
+
+private val Context.uiDataStore: DataStore<Preferences> by preferencesDataStore(name = "ui_prefs")
+
+data class UiSettings(
+    val style: AppStyle,
+    val highContrast: Boolean = false,
+    val fontScale: Float = 1f,
+)
+
+/**
+ * Design preferences, persisted with Preferences DataStore.
+ *
+ * Migration: if no style was ever stored, the upstream "m3e_enabled" SharedPreference decides
+ * between MATERIAL and APPLE (upstream default is m3e_enabled = true).
+ * For backwards compatibility every style change also writes "m3e_enabled".
+ */
+class UiPreferencesRepository private constructor(private val appContext: Context) {
+
+    private val legacy = appContext.getSharedPreferences("settings", Context.MODE_PRIVATE)
+
+    fun legacyDefault(): UiSettings = UiSettings(
+        style = if (legacy.getBoolean("m3e_enabled", true)) AppStyle.MATERIAL else AppStyle.APPLE
+    )
+
+    val settings: Flow<UiSettings> = appContext.uiDataStore.data
+        .catch { e -> if (e is IOException) emit(emptyPreferences()) else throw e }
+        .map { p ->
+            UiSettings(
+                style = AppStyle.fromKey(p[KEY_STYLE]) ?: legacyDefault().style,
+                highContrast = p[KEY_HIGH_CONTRAST] ?: false,
+                fontScale = (p[KEY_FONT_SCALE] ?: 1f).coerceIn(MIN_FONT_SCALE, MAX_FONT_SCALE),
+            )
+        }
+        .distinctUntilChanged()
+
+    suspend fun setStyle(style: AppStyle) {
+        appContext.uiDataStore.edit { it[KEY_STYLE] = style.name }
+        legacy.edit { putBoolean("m3e_enabled", style == AppStyle.MATERIAL) }
+    }
+
+    suspend fun setHighContrast(enabled: Boolean) {
+        appContext.uiDataStore.edit { it[KEY_HIGH_CONTRAST] = enabled }
+    }
+
+    suspend fun setFontScale(scale: Float) {
+        appContext.uiDataStore.edit { it[KEY_FONT_SCALE] = scale.coerceIn(MIN_FONT_SCALE, MAX_FONT_SCALE) }
+    }
+
+    companion object {
+        private val KEY_STYLE = stringPreferencesKey("app_style")
+        private val KEY_HIGH_CONTRAST = booleanPreferencesKey("high_contrast")
+        private val KEY_FONT_SCALE = floatPreferencesKey("font_scale")
+
+        @Volatile
+        private var instance: UiPreferencesRepository? = null
+
+        fun get(context: Context): UiPreferencesRepository =
+            instance ?: synchronized(this) {
+                instance ?: UiPreferencesRepository(context.applicationContext).also { instance = it }
+            }
+    }
+}
