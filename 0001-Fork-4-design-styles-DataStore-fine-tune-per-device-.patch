+@Composable
+fun AutoConnectSettingsScreen() {
+    val context = LocalContext.current
+    val prefs = remember { context.getSharedPreferences("settings", MODE_PRIVATE) }
+
+    // Re-read permission / battery / CDM state while visible (covers returning from system
+    // screens without depending on lifecycle-runtime-compose).
+    var refreshTick by remember { mutableIntStateOf(0) }
+    LaunchedEffect(Unit) {
+        while (true) {
+            delay(2000)
+            refreshTick++
+        }
+    }
+    // Mirror the SharedPreferences into Compose state.
+    var settings by remember { mutableStateOf(AutoConnectPrefs.load(prefs)) }
+    var scanMode by remember { mutableIntStateOf(prefs.getInt(BLEManager.PREF_SCAN_MODE, BLEManager.SCAN_MODE_PREF_LOW_LATENCY)) }
+    var startOnBoot by remember { mutableStateOf(prefs.getBoolean(AutoConnectPrefs.START_ON_BOOT, true)) }
+    DisposableEffect(prefs) {
+        val l = SharedPreferences.OnSharedPreferenceChangeListener { p, _ ->
+            settings = AutoConnectPrefs.load(p)
+            scanMode = p.getInt(BLEManager.PREF_SCAN_MODE, BLEManager.SCAN_MODE_PREF_LOW_LATENCY)
+            startOnBoot = p.getBoolean(AutoConnectPrefs.START_ON_BOOT, true)
+        }
+        prefs.registerOnSharedPreferenceChangeListener(l)
+        onDispose { prefs.unregisterOnSharedPreferenceChangeListener(l) }
+    }
+
+    val permissionLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.RequestMultiplePermissions()
+    ) { refreshTick++ }
+    val intentSenderLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.StartIntentSenderForResult()
+    ) { refreshTick++ }
+
+    val m3eEnabled = LocalDesignSystem.current == DesignSystem.Material
+    val topPadding = if (m3eEnabled) 0.dp else WindowInsets.statusBars.asPaddingValues().calculateTopPadding() + 84.dp
+    val bottomPadding = if (m3eEnabled) 16.dp else WindowInsets.navigationBars.asPaddingValues().calculateBottomPadding() + 16.dp
+
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.surfaceContainer)
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(20.dp)
+    ) {
+        Spacer(Modifier.height(topPadding))
+
+        ConnectionStatusCard(
+            fallbackName = prefs.getString("name", null) ?: "AirPods",
+            onOpenAutoConnectSettings = {
+                permissionLauncher.launch(AutoConnectPermissions.runtimePermissions().toTypedArray())
+            }
+        )
+
+        ForkSection(title = stringResource(R.string.fork_auto_connect)) {
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_auto_connect_enabled),
+                description = stringResource(R.string.fork_auto_connect_enabled_desc),
+                checked = settings.enabled,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.ENABLED, it) } }
+            )
+            val off = if (settings.enabled) null else stringResource(R.string.fork_status_paused)
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_trigger_lid),
+                checked = settings.onLidOpen,
+                disabledReason = off,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.ON_LID_OPEN, it) } }
+            )
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_trigger_in_ear),
+                checked = settings.onInEar,
+                disabledReason = off,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.ON_IN_EAR, it) } }
+            )
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_trigger_nearby),
+                description = stringResource(R.string.fork_trigger_nearby_desc),
+                checked = settings.onNearby,
+                disabledReason = off,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.ON_NEARBY, it) } }
+            )
+            val rssiFmt = stringResource(R.string.fork_rssi_value)
+            PreciseSlider(
+                label = stringResource(R.string.fork_rssi_threshold),
+                value = settings.nearbyRssiThreshold,
+                range = -90..-40,
+                valueText = { String.format(rssiFmt, it) },
+                disabledReason = off ?: if (!settings.onNearby) stringResource(R.string.fork_trigger_nearby) + " – off" else null,
+                onValueChange = { prefs.edit { putInt(AutoConnectPrefs.RSSI_THRESHOLD, it) } }
+            )
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_respect_other),
+                checked = settings.respectActiveOtherDevice,
+                disabledReason = off,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.RESPECT_OTHER_DEVICE, it) } }
+            )
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_reconnect_link_loss),
+                checked = settings.reconnectOnLinkLoss,
+                disabledReason = off,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.RECONNECT_ON_LINK_LOSS, it) } }
+            )
+            PreciseSlider(
+                label = stringResource(R.string.fork_max_attempts),
+                value = settings.maxAttempts,
+                range = 1..AutoConnectController.MAX_ATTEMPTS_CAP,
+                disabledReason = off,
+                onValueChange = { prefs.edit { putInt(AutoConnectPrefs.MAX_ATTEMPTS, it) } }
+            )
+        }
+
+        ForkSection(title = stringResource(R.string.fork_scan_mode)) {
+            Column(Modifier.selectableGroup()) {
+                listOf(
+                    BLEManager.SCAN_MODE_PREF_LOW_POWER to R.string.fork_scan_low_power,
+                    BLEManager.SCAN_MODE_PREF_BALANCED to R.string.fork_scan_balanced,
+                    BLEManager.SCAN_MODE_PREF_LOW_LATENCY to R.string.fork_scan_low_latency,
+                ).forEach { (mode, label) ->
+                    Row(
+                        verticalAlignment = Alignment.CenterVertically,
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .heightIn(min = MinTouchTarget)
+                            .selectable(
+                                selected = scanMode == mode,
+                                role = Role.RadioButton,
+                                onClick = { prefs.edit { putInt(BLEManager.PREF_SCAN_MODE, mode) } }
+                            )
+                            .padding(horizontal = 16.dp)
+                    ) {
+                        RadioButton(selected = scanMode == mode, onClick = null)
+                        Spacer(Modifier.width(12.dp))
+                        Text(stringResource(label), style = MaterialTheme.typography.bodyLarge)
+                    }
+                }
+            }
+        }
+
+        // ---- Background execution ------------------------------------------------------------
+        val granted = stringResource(R.string.fork_granted)
+        val notGranted = stringResource(R.string.fork_not_granted)
+        val btOk = remember(refreshTick) { AutoConnectPermissions.hasScanAndConnect(context) }
+        val notifOk = remember(refreshTick) { AutoConnectPermissions.isGranted(context, Manifest.permission.POST_NOTIFICATIONS) }
+        val batteryOk = remember(refreshTick) { AutoConnectPermissions.isIgnoringBatteryOptimizations(context) }
+        val mac = remember(refreshTick) { prefs.getString("mac_address", null)?.takeIf { it.isNotBlank() } }
+        val cdmSupported = remember { CompanionAssociation.isSupported(context) }
+        val cdmAssociated = remember(refreshTick, mac) { CompanionAssociation.isAssociated(context, mac) }
+
+        ForkSection(title = stringResource(R.string.fork_background)) {
+            ForkInfoRow(stringResource(R.string.fork_perm_bluetooth), if (btOk) granted else notGranted, !btOk) {
+                if (!btOk) TextButton(onClick = {
+                    permissionLauncher.launch(AutoConnectPermissions.runtimePermissions().toTypedArray())
+                }) { Text(stringResource(R.string.fork_action_grant)) }
+            }
+            ForkInfoRow(stringResource(R.string.fork_perm_notifications), if (notifOk) granted else notGranted, !notifOk) {
+                if (!notifOk) TextButton(onClick = {
+                    permissionLauncher.launch(arrayOf(Manifest.permission.POST_NOTIFICATIONS))
+                }) { Text(stringResource(R.string.fork_action_grant)) }
+            }
+            ForkInfoRow(
+                stringResource(R.string.fork_perm_battery),
+                (if (batteryOk) granted else notGranted) + " · " + stringResource(R.string.fork_perm_battery_desc),
+                !batteryOk
+            ) {
+                if (!batteryOk) TextButton(onClick = {
+                    try {
+                        context.startActivity(AutoConnectPermissions.batteryOptimizationIntent(context))
+                    } catch (_: Exception) {
+                        context.startActivity(AutoConnectPermissions.appDetailsIntent(context))
+                    }
+                }) { Text(stringResource(R.string.fork_action_grant)) }
+            }
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_start_on_boot),
+                checked = startOnBoot,
+                onCheckedChange = { prefs.edit { putBoolean(AutoConnectPrefs.START_ON_BOOT, it) } }
+            )
+            val cdmValue = when {
+                !cdmSupported -> stringResource(R.string.fork_cdm_unsupported)
+                mac == null -> stringResource(R.string.fork_cdm_no_mac)
+                cdmAssociated -> granted
+                else -> stringResource(R.string.fork_cdm_desc)
+            }
+            ForkInfoRow(stringResource(R.string.fork_cdm), cdmValue, cdmSupported && mac != null && !cdmAssociated) {
+                if (cdmSupported && mac != null) {
+                    if (cdmAssociated) {
+                        TextButton(onClick = { CompanionAssociation.disassociate(context, mac); refreshTick++ }) {
+                            Text(stringResource(R.string.fork_cdm_remove))
+                        }
+                    } else {
+                        TextButton(onClick = {
+                            CompanionAssociation.associate(
+                                context = context,
+                                mac = mac,
+                                onPending = { sender -> intentSenderLauncher.launch(IntentSenderRequest.Builder(sender).build()) },
+                                onCreated = { refreshTick++ },
+                                onFailed = { err -> Toast.makeText(context, err ?: "CDM error", Toast.LENGTH_LONG).show() }
+                            )
+                        }) { Text(stringResource(R.string.fork_cdm_associate)) }
+                    }
+                }
+            }
+        }
+
+        ForkSection(title = stringResource(R.string.fork_behaviour)) {
+            Text(
+                stringResource(R.string.fork_behaviour_text),
+                style = MaterialTheme.typography.bodyMedium,
+                modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp)
+            )
+        }
+        Spacer(Modifier.height(bottomPadding))
+    }
+}
