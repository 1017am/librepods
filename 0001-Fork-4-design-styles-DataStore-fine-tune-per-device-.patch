diff --git a/android/app/src/test/java/me/kavishdevar/librepods/bluetooth/autoconnect/AutoConnectControllerTest.kt b/android/app/src/test/java/me/kavishdevar/librepods/bluetooth/autoconnect/AutoConnectControllerTest.kt
new file mode 100644
index 0000000..8370d1e
--- /dev/null
+++ b/android/app/src/test/java/me/kavishdevar/librepods/bluetooth/autoconnect/AutoConnectControllerTest.kt
@@ -0,0 +1,187 @@
+package me.kavishdevar.librepods.bluetooth.autoconnect
+
+import me.kavishdevar.librepods.bluetooth.autoconnect.AutoConnectController.Action
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AutoConnectControllerTest {
+
+    private var now = 1_000_000L
+    private fun controller(s: AutoConnectSettings = AutoConnectSettings()) = AutoConnectController({ now }, s)
+
+    private fun sighting(
+        rpa: String = "11:11:11:11:11:11",
+        id: String? = "AA:AA:AA:AA:AA:AA",
+        rssi: Int = -55,
+        lid: Boolean = false,
+        left: Boolean = false,
+        right: Boolean = false,
+        remote: String = RemoteState.DISCONNECTED,
+    ) = Sighting(rpa, id, rssi, lid, left, right, remote, now)
+
+    @Test fun lidOpenEdgeTriggersConnect() {
+        val c = controller()
+        val closed = sighting(lid = false)
+        val open = sighting(lid = true)
+        assertEquals(Action.None, c.onSighting(null, closed, listOf(closed)))
+        val a = c.onSighting(closed, open, listOf(open))
+        assertTrue(a is Action.Connect)
+        a as Action.Connect
+        assertEquals(Trigger.LID_OPENED, a.trigger)
+        assertEquals(1, a.attempt)
+        assertEquals(0L, a.delayMs)
+        assertTrue(c.connecting)
+    }
+
+    @Test fun noRetriggerWhileLidStaysOpen() {
+        val c = controller()
+        val open = sighting(lid = true)
+        c.onSighting(null, open, listOf(open))
+        c.onConnectSucceeded("AA:AA:AA:AA:AA:AA")
+        assertEquals(Action.None, c.onSighting(open, open, listOf(open)))
+    }
+
+    @Test fun inEarEdgeTriggers() {
+        val c = controller(AutoConnectSettings(onLidOpen = false))
+        val out = sighting()
+        val worn = sighting(left = true)
+        assertEquals(Action.None, c.onSighting(null, out, listOf(out)))
+        val a = c.onSighting(out, worn, listOf(worn)) as Action.Connect
+        assertEquals(Trigger.PUT_IN_EAR, a.trigger)
+    }
+
+    @Test fun disabledDoesNothing() {
+        val c = controller(AutoConnectSettings(enabled = false))
+        assertEquals(Action.None, c.onSighting(null, sighting(lid = true), listOf(sighting(lid = true))))
+    }
+
+    @Test fun nearbyIsOptInAndRespectsThreshold() {
+        val off = controller()
+        assertEquals(Action.None, off.onSighting(null, sighting(rssi = -40), listOf(sighting(rssi = -40))))
+
+        val on = controller(AutoConnectSettings(onLidOpen = false, onInEar = false, onNearby = true, nearbyRssiThreshold = -60))
+        assertEquals(Action.None, on.onSighting(null, sighting(rssi = -70), listOf(sighting(rssi = -70))))
+        val a = on.onSighting(null, sighting(rssi = -50), listOf(sighting(rssi = -50))) as Action.Connect
+        assertEquals(Trigger.NEARBY, a.trigger)
+    }
+
+    @Test fun respectsActiveOtherHost() {
+        val c = controller()
+        val playingElsewhere = sighting(lid = true, remote = RemoteState.MUSIC)
+        assertEquals(Action.None, c.onSighting(sighting(), playingElsewhere, listOf(playingElsewhere)))
+
+        val greedy = controller(AutoConnectSettings(respectActiveOtherDevice = false))
+        assertTrue(greedy.onSighting(sighting(), playingElsewhere, listOf(playingElsewhere)) is Action.Connect)
+    }
+
+    @Test fun retriesWithBackoffThenGivesUp() {
+        val c = controller(AutoConnectSettings(maxAttempts = 3))
+        val open = sighting(lid = true)
+        c.onSighting(sighting(), open, listOf(open)) as Action.Connect
+        val r2 = c.onConnectFailed() as Action.Connect
+        assertEquals(2, r2.attempt); assertEquals(3_000L, r2.delayMs)
+        val r3 = c.onConnectFailed() as Action.Connect
+        assertEquals(3, r3.attempt); assertEquals(8_000L, r3.delayMs)
+        assertEquals(Action.GiveUp, c.onConnectFailed())
+        assertFalse(c.connecting)
+    }
+
+    @Test fun userDisconnectPausesUntilNewGesture() {
+        val c = controller()
+        val open = sighting(lid = true)
+        c.onSighting(sighting(), open, listOf(open))
+        c.onConnectSucceeded("AA:AA:AA:AA:AA:AA")
+        assertEquals(Action.None, c.onDisconnected(userInitiated = true, stillActive = true))
+        assertTrue(c.paused)
+
+        // Remote host disconnect is not a deliberate gesture → stays paused.
+        now += 60_000
+        val remoteIdle = sighting(lid = true, remote = RemoteState.IDLE)
+        val remoteGone = sighting(lid = true, remote = RemoteState.DISCONNECTED)
+        assertEquals(Action.None, c.onSighting(remoteIdle, remoteGone, listOf(remoteGone)))
+
+        // Close + reopen the lid → new gesture → connect again.
+        val closed = sighting(lid = false)
+        c.onSighting(open, closed, listOf(closed))
+        val a = c.onSighting(closed, open, listOf(open))
+        assertTrue(a is Action.Connect)
+        assertFalse(c.paused)
+    }
+
+    @Test fun linkLossWhileWornReconnects() {
+        val c = controller()
+        val worn = sighting(left = true, right = true)
+        c.onSighting(sighting(), worn, listOf(worn))
+        c.onConnectSucceeded("AA:AA:AA:AA:AA:AA")
+        val a = c.onDisconnected(userInitiated = false, stillActive = true) as Action.Connect
+        assertEquals(Trigger.UNEXPECTED_DISCONNECT, a.trigger)
+        assertEquals(AutoConnectController.LINK_LOSS_DELAY_MS, a.delayMs)
+    }
+
+    @Test fun linkLossInCaseDoesNotReconnect() {
+        val c = controller()
+        val open = sighting(lid = true)
+        c.onSighting(sighting(), open, listOf(open))
+        c.onConnectSucceeded(null)
+        assertEquals(Action.None, c.onDisconnected(userInitiated = false, stillActive = false))
+    }
+
+    @Test fun otherDeviceTakeoverPauses() {
+        val c = controller()
+        c.onOtherDeviceTookOver()
+        now += 60_000
+        val remoteIdle = sighting(lid = true, remote = RemoteState.IDLE)
+        val remoteGone = sighting(lid = true, remote = RemoteState.DISCONNECTED)
+        assertEquals(Action.None, c.onSighting(remoteIdle, remoteGone, listOf(remoteGone)))
+        c.onAllDisappeared()
+        assertFalse(c.paused)
+    }
+
+    @Test fun multipleOwnPairsPreferLastConnectedThenWornThenLidThenRssi() {
+        val c = controller()
+        val a = sighting(rpa = "01", id = "A", rssi = -40, lid = true)
+        val b = sighting(rpa = "02", id = "B", rssi = -80, left = true)
+        val d = sighting(rpa = "03", id = "D", rssi = -30)
+        assertEquals("02", c.selectTarget(listOf(a, b, d), lastIdentity = null)!!.rpa)  // worn wins
+        assertEquals("01", c.selectTarget(listOf(a, d), lastIdentity = null)!!.rpa)     // lid open wins
+        assertEquals("03", c.selectTarget(listOf(d, sighting(rpa = "04", id = "E", rssi = -90)), null)!!.rpa) // rssi
+        assertEquals("01", c.selectTarget(listOf(a, b, d), lastIdentity = "a")!!.rpa)  // last connected, case-insensitive
+    }
+
+    @Test fun nonTargetPairDoesNotConnect() {
+        val c = controller()
+        val worn = sighting(rpa = "02", id = "B", left = true)
+        val lidOpenOther = sighting(rpa = "01", id = "A", lid = true)
+        // "A" lid just opened, but "B" is being worn → B is the target, A's edge is ignored.
+        assertEquals(Action.None, c.onSighting(sighting(rpa = "01", id = "A"), lidOpenOther, listOf(lidOpenOther, worn)))
+    }
+
+    @Test fun minIntervalBetweenTriggerAttempts() {
+        val c = controller()
+        val closed = sighting()
+        val open = sighting(lid = true)
+        assertTrue(c.onSighting(closed, open, listOf(open)) is Action.Connect)
+        assertEquals(Action.GiveUp, run { repeat(4) { c.onConnectFailed() }; c.onConnectFailed() })
+        // Immediately re-open: blocked by MIN_TRIGGER_INTERVAL_MS (last scheduled attempt was +45 s).
+        c.onSighting(open, closed, listOf(closed))
+        assertEquals(Action.None, c.onSighting(closed, open, listOf(open)))
+        now += 120_000
+        c.onSighting(open, closed, listOf(closed))
+        assertTrue(c.onSighting(closed, open, listOf(open)) is Action.Connect)
+    }
+
+    @Test fun manualConnectClearsPause() {
+        val c = controller()
+        c.onOtherDeviceTookOver()
+        val a = c.onManualConnect(emptyList()) as Action.Connect
+        assertEquals(Trigger.MANUAL, a.trigger)
+        assertFalse(c.paused)
+    }
+
+    @Test fun maxAttemptsIsClamped() {
+        val c = controller(AutoConnectSettings(maxAttempts = 99))
+        assertEquals(AutoConnectController.MAX_ATTEMPTS_CAP, c.settings.maxAttempts)
+    }
+}
diff --git a/android/app/src/test/java/me/kavishdevar/librepods/data/support/FeatureSupportTest.kt b/android/app/src/test/java/me/kavishdevar/librepods/data/support/FeatureSupportTest.kt
new file mode 100644
index 0000000..bf05e17
--- /dev/null
+++ b/android/app/src/test/java/me/kavishdevar/librepods/data/support/FeatureSupportTest.kt
@@ -0,0 +1,105 @@
+package me.kavishdevar.librepods.data.support
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class FeatureSupportTest {
+
+    private val pro2Caps = setOf(
+        "LISTENING_MODE", "CONVERSATION_AWARENESS", "STEM_CONFIG", "LOUD_SOUND_REDUCTION",
+        "SLEEP_DETECTION", "HEARING_AID", "ADAPTIVE_AUDIO", "ADAPTIVE_VOLUME", "SWIPE_FOR_VOLUME", "HEAD_GESTURES"
+    )
+
+    private fun input(
+        connected: Boolean = true,
+        confirmed: Boolean = true,
+        caps: Set<String> = pro2Caps,
+        reported: Set<String> = setOf("LISTENING_MODE", "LISTENING_MODE_CONFIGS", "CONVERSATION_DETECT_CONFIG", "AUTO_ANC_STRENGTH"),
+        eq: Boolean = false,
+        hook: Boolean = false,
+        premium: Boolean = true,
+    ) = SupportInput(connected, confirmed, caps, reported, eq, hook, premium)
+
+    private fun reason(f: Feature, i: SupportInput) = (FeatureSupport.evaluate(f, i) as? Support.Unavailable)?.reason
+
+    @Test fun disconnectedBlocksEverything() {
+        Feature.entries.forEach { assertEquals(UnsupportedReason.NOT_CONNECTED, reason(it, input(connected = false))) }
+    }
+
+    @Test fun modelWithoutCapability() {
+        val airpods2 = input(caps = emptySet(), reported = emptySet())
+        assertEquals(UnsupportedReason.MODEL_LACKS, reason(Feature.LISTENING_MODE, airpods2))
+        assertEquals(UnsupportedReason.MODEL_LACKS, reason(Feature.CONVERSATION_AWARENESS, airpods2))
+    }
+
+    @Test fun reportedControlIsAvailable() {
+        assertNull(reason(Feature.LISTENING_MODE, input()))
+        assertNull(reason(Feature.CONVERSATION_AWARENESS, input()))
+    }
+
+    @Test fun notReportedByFirmware() {
+        assertEquals(UnsupportedReason.NOT_REPORTED_BY_DEVICE, reason(Feature.SLEEP_DETECTION, input()))
+        assertEquals(UnsupportedReason.NOT_REPORTED_BY_DEVICE, reason(Feature.CUSTOM_EQ, input(eq = false)))
+        assertNull(reason(Feature.CUSTOM_EQ, input(eq = true)))
+    }
+
+    @Test fun vendorHookFeatures() {
+        assertEquals(UnsupportedReason.NEEDS_VENDOR_ID_HOOK, reason(Feature.LOUD_SOUND_REDUCTION, input()))
+        assertNull(reason(Feature.LOUD_SOUND_REDUCTION, input(hook = true)))
+    }
+
+    @Test fun premiumGateComesLast() {
+        assertEquals(UnsupportedReason.NEEDS_PREMIUM, reason(Feature.CONVERSATION_AWARENESS, input(premium = false)))
+        // Not premium AND not reported → the device reason wins (more useful to the user).
+        assertEquals(UnsupportedReason.NOT_REPORTED_BY_DEVICE, reason(Feature.SLEEP_DETECTION, input(premium = false)))
+        assertNull(reason(Feature.LISTENING_MODE, input(premium = false)))
+    }
+
+    @Test fun unknownModelReliesOnDeviceReports() {
+        val unknown = input(confirmed = false, caps = emptySet())
+        assertNull(reason(Feature.LISTENING_MODE, unknown)) // device reported it → it exists
+        assertEquals(UnsupportedReason.MODEL_UNKNOWN, reason(Feature.SLEEP_DETECTION, unknown))
+        assertEquals(UnsupportedReason.MODEL_UNKNOWN, reason(Feature.HEAD_GESTURES, unknown))
+    }
+
+    @Test fun profilePlanSkipsUnsupportedAndPremium() {
+        val snapshot = mapOf(
+            "LISTENING_MODE_CONFIGS" to byteArrayOf(0x0E),
+            "CONVERSATION_DETECT_CONFIG" to byteArrayOf(0x01),
+            "SLEEP_DETECTION_CONFIG" to byteArrayOf(0x01),
+            "MIC_MODE" to byteArrayOf(0x00),
+            "OWNS_CONNECTION" to byteArrayOf(0x01),
+        )
+        val current = mapOf(
+            "LISTENING_MODE_CONFIGS" to byteArrayOf(0x07),
+            "CONVERSATION_DETECT_CONFIG" to byteArrayOf(0x02),
+            "MIC_MODE" to byteArrayOf(0x00),
+        )
+        val free = ProfileApplyPlanner.plan(snapshot, current, premium = false)
+        assertEquals(setOf("LISTENING_MODE_CONFIGS"), free.send.keys)
+        assertEquals(SkipReason.NEEDS_PREMIUM, free.skipped["CONVERSATION_DETECT_CONFIG"])
+        assertEquals(SkipReason.NOT_REPORTED_BY_DEVICE, free.skipped["SLEEP_DETECTION_CONFIG"])
+        assertEquals(SkipReason.ALREADY_EQUAL, free.skipped["MIC_MODE"])
+        assertEquals(SkipReason.NOT_ALLOWED, free.skipped["OWNS_CONNECTION"])
+
+        val paid = ProfileApplyPlanner.plan(snapshot, current, premium = true)
+        assertEquals(setOf("LISTENING_MODE_CONFIGS", "CONVERSATION_DETECT_CONFIG"), paid.send.keys)
+    }
+
+    @Test fun captureOnlyWhitelisted() {
+        val cur = mapOf("MIC_MODE" to byteArrayOf(1), "OWNS_CONNECTION" to byteArrayOf(1))
+        assertEquals(setOf("MIC_MODE"), ProfileApplyPlanner.capture(cur).keys)
+    }
+
+    @Test fun hexRoundTrip() {
+        val b = byteArrayOf(0x00, 0x7F, 0x80.toByte(), 0xFF.toByte())
+        assertEquals("007F80FF", ProfileApplyPlanner.toHex(b))
+        assertArrayEquals(b, ProfileApplyPlanner.fromHex("007F80FF"))
+        assertNull(ProfileApplyPlanner.fromHex("ABC"))
+        assertNull(ProfileApplyPlanner.fromHex("ZZ"))
+        assertTrue(ProfileApplyPlanner.fromHex("")!!.isEmpty())
+    }
+}
