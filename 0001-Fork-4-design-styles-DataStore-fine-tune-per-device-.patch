+*/
+
+package me.kavishdevar.librepods.data.prefs
+
+import android.content.Context
+import android.util.Log
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.emptyPreferences
+import androidx.datastore.preferences.core.stringPreferencesKey
+import androidx.datastore.preferences.preferencesDataStore
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.map
+import me.kavishdevar.librepods.data.support.ProfileApplyPlanner
+import org.json.JSONArray
+import org.json.JSONException
+import org.json.JSONObject
+import java.io.IOException
+import java.util.UUID
+
+private val Context.profileDataStore: DataStore<Preferences> by preferencesDataStore(name = "device_profiles")
+
+/** 3-band custom EQ as implemented by upstream (CustomEq low/mid/high 0..100). */
+data class EqPreset(
+    val id: String = UUID.randomUUID().toString(),
+    val name: String,
+    val low: Int,
+    val mid: Int,
+    val high: Int,
+)
+
+/**
+ * A snapshot of AirPods settings for one device (keyed by classic MAC).
+ * [controls] holds raw AACP control-command bytes by ControlCommandIdentifiers name.
+ */
+data class DeviceProfile(
+    val id: String = UUID.randomUUID().toString(),
+    val name: String,
+    val createdAtMillis: Long = System.currentTimeMillis(),
+    val controls: Map<String, ByteArray>,
+    val eq: EqPreset? = null,
+    val leftLongPress: String? = null,
+    val rightLongPress: String? = null,
+)
+
+class DeviceProfileRepository private constructor(private val appContext: Context) {
+
+    private fun profilesKey(mac: String) = stringPreferencesKey("profiles_${normalize(mac)}")
+    private fun eqKey(mac: String) = stringPreferencesKey("eq_presets_${normalize(mac)}")
+
+    private val data: Flow<Preferences> = appContext.profileDataStore.data
+        .catch { e -> if (e is IOException) emit(emptyPreferences()) else throw e }
+
+    fun profiles(mac: String): Flow<List<DeviceProfile>> =
+        data.map { decodeProfiles(it[profilesKey(mac)]) }
+
+    fun eqPresets(mac: String): Flow<List<EqPreset>> =
+        data.map { decodeEq(it[eqKey(mac)]) }
+
+    suspend fun saveProfile(mac: String, profile: DeviceProfile) {
+        appContext.profileDataStore.edit { p ->
+            val list = decodeProfiles(p[profilesKey(mac)]).filterNot { it.id == profile.id } + profile
+            p[profilesKey(mac)] = encodeProfiles(list.takeLast(MAX_ITEMS))
+        }
+    }
+
+    suspend fun deleteProfile(mac: String, id: String) {
+        appContext.profileDataStore.edit { p ->
+            p[profilesKey(mac)] = encodeProfiles(decodeProfiles(p[profilesKey(mac)]).filterNot { it.id == id })
+        }
+    }
+
+    suspend fun saveEqPreset(mac: String, preset: EqPreset) {
+        appContext.profileDataStore.edit { p ->
+            val list = decodeEq(p[eqKey(mac)]).filterNot { it.id == preset.id } + preset
+            p[eqKey(mac)] = encodeEq(list.takeLast(MAX_ITEMS))
+        }
+    }
+
+    suspend fun deleteEqPreset(mac: String, id: String) {
+        appContext.profileDataStore.edit { p ->
+            p[eqKey(mac)] = encodeEq(decodeEq(p[eqKey(mac)]).filterNot { it.id == id })
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // JSON (org.json is part of the Android framework)
+    // ---------------------------------------------------------------------------------------
+
+    private fun encodeEqObj(e: EqPreset) = JSONObject()
+        .put("id", e.id).put("name", e.name).put("low", e.low).put("mid", e.mid).put("high", e.high)
+
+    private fun decodeEqObj(o: JSONObject) = EqPreset(
+        id = o.getString("id"),
+        name = o.getString("name"),
+        low = o.getInt("low").coerceIn(0, 100),
+        mid = o.getInt("mid").coerceIn(0, 100),
+        high = o.getInt("high").coerceIn(0, 100),
+    )
+
+    private fun encodeEq(list: List<EqPreset>): String =
+        JSONArray().apply { list.forEach { put(encodeEqObj(it)) } }.toString()
+
+    private fun decodeEq(raw: String?): List<EqPreset> = safeDecode(raw) { arr ->
+        (0 until arr.length()).map { decodeEqObj(arr.getJSONObject(it)) }
+    }
+
+    private fun encodeProfiles(list: List<DeviceProfile>): String = JSONArray().apply {
+        list.forEach { p ->
+            val controls = JSONObject()
+            p.controls.forEach { (k, v) -> controls.put(k, ProfileApplyPlanner.toHex(v)) }
+            put(
+                JSONObject()
+                    .put("id", p.id)
+                    .put("name", p.name)
+                    .put("createdAt", p.createdAtMillis)
+                    .put("controls", controls)
+                    .put("eq", p.eq?.let { encodeEqObj(it) } ?: JSONObject.NULL)
+                    .put("leftLongPress", p.leftLongPress ?: JSONObject.NULL)
+                    .put("rightLongPress", p.rightLongPress ?: JSONObject.NULL)
+            )
+        }
+    }.toString()
+
+    private fun decodeProfiles(raw: String?): List<DeviceProfile> = safeDecode(raw) { arr ->
+        (0 until arr.length()).map { i ->
+            val o = arr.getJSONObject(i)
+            val c = o.getJSONObject("controls")
+            val controls = c.keys().asSequence().mapNotNull { k ->
+                ProfileApplyPlanner.fromHex(c.getString(k))?.let { k to it }
+            }.toMap()
+            DeviceProfile(
+                id = o.getString("id"),
+                name = o.getString("name"),
+                createdAtMillis = o.optLong("createdAt", 0L),
+                controls = controls,
+                eq = o.optJSONObject("eq")?.let { decodeEqObj(it) },
+                leftLongPress = o.optString("leftLongPress").takeIf { it.isNotEmpty() && !o.isNull("leftLongPress") },
+                rightLongPress = o.optString("rightLongPress").takeIf { it.isNotEmpty() && !o.isNull("rightLongPress") },
+            )
+        }
+    }
+
+    private fun <T> safeDecode(raw: String?, block: (JSONArray) -> List<T>): List<T> {
+        if (raw.isNullOrBlank()) return emptyList()
+        return try {
+            block(JSONArray(raw))
+        } catch (e: JSONException) {
+            Log.e("DeviceProfiles", "Corrupt profile data, ignoring", e)
+            emptyList()
+        }
+    }
+
+    companion object {
+        private const val MAX_ITEMS = 20
+        const val UNKNOWN_DEVICE = "unknown"
+
+        fun normalize(mac: String) = mac.uppercase().replace(":", "")
+
+        @Volatile
+        private var instance: DeviceProfileRepository? = null
+
+        fun get(context: Context): DeviceProfileRepository =
+            instance ?: synchronized(this) {
+                instance ?: DeviceProfileRepository(context.applicationContext).also { instance = it }
+            }
+    }
+}
