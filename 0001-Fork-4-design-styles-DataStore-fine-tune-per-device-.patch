+    along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+// NOTE: this file must stay free of android.* imports — it is compiled and unit-tested on the JVM.
+package me.kavishdevar.librepods.data.support
+
+/**
+ * Only features LibrePods v1.0.4 already implements. Strings are the *names* of
+ * data.Capability and AACPManager.ControlCommandIdentifiers so this file stays JVM-testable.
+ */
+enum class Feature(
+    val capability: String?,
+    val controlId: String?,
+    val needsVendorIdHook: Boolean = false,
+    val premium: Boolean = false,
+    /** Needs a CUSTOM_EQ packet from the device (firmware-dependent). */
+    val needsCustomEqReport: Boolean = false,
+) {
+    LISTENING_MODE("LISTENING_MODE", "LISTENING_MODE"),
+    LONG_PRESS_MODES("LISTENING_MODE", "LISTENING_MODE_CONFIGS"),
+    ONE_BUD_ANC("LISTENING_MODE", "ONE_BUD_ANC_MODE", premium = true),
+    CONVERSATION_AWARENESS("CONVERSATION_AWARENESS", "CONVERSATION_DETECT_CONFIG", premium = true),
+    ADAPTIVE_STRENGTH("ADAPTIVE_AUDIO", "AUTO_ANC_STRENGTH", premium = true),
+    ADAPTIVE_VOLUME("ADAPTIVE_VOLUME", "ADAPTIVE_VOLUME_CONFIG", premium = true),
+    CUSTOM_EQ(null, null, needsCustomEqReport = true),
+    STEM_ACTIONS("STEM_CONFIG", null, premium = true),
+    HEAD_GESTURES("HEAD_GESTURES", null, premium = true),
+    CHIME_VOLUME(null, "CHIME_VOLUME", premium = true),
+    SLEEP_DETECTION("SLEEP_DETECTION", "SLEEP_DETECTION_CONFIG", premium = true),
+    VOLUME_SWIPE("SWIPE_FOR_VOLUME", "VOLUME_SWIPE_MODE", premium = true),
+    LOUD_SOUND_REDUCTION("LOUD_SOUND_REDUCTION", null, needsVendorIdHook = true),
+    HEARING_AID("HEARING_AID", null, needsVendorIdHook = true),
+    TRANSPARENCY_CUSTOMIZATION("LISTENING_MODE", null, needsVendorIdHook = true),
+}
+
+enum class UnsupportedReason {
+    NOT_CONNECTED,
+    /** Model number known and the model doesn't have the capability. */
+    MODEL_LACKS,
+    /** Needs the VendorID hook (root + Xposed). */
+    NEEDS_VENDOR_ID_HOOK,
+    /** The AirPods never reported this setting → probably firmware/model doesn't support it. */
+    NOT_REPORTED_BY_DEVICE,
+    /** Model unknown and nothing reported → can't tell. */
+    MODEL_UNKNOWN,
+    /** Available on the device but locked behind upstream's "advanced features" purchase. */
+    NEEDS_PREMIUM,
+}
+
+sealed interface Support {
+    data object Available : Support
+    data class Unavailable(val reason: UnsupportedReason) : Support
+}
+
+data class SupportInput(
+    val connected: Boolean,
+    /** True only when the model number came from the AirPods (not upstream's A3049 fallback). */
+    val modelConfirmed: Boolean,
+    val modelCapabilities: Set<String>,
+    /** Control identifiers the AirPods themselves sent (not values we sent). */
+    val reportedControls: Set<String>,
+    val customEqReported: Boolean,
+    val vendorIdHook: Boolean,
+    val premium: Boolean,
+)
+
+object FeatureSupport {
+
+    fun evaluate(feature: Feature, input: SupportInput): Support {
+        if (!input.connected) return Support.Unavailable(UnsupportedReason.NOT_CONNECTED)
+
+        val capOk = feature.capability == null || feature.capability in input.modelCapabilities
+        if (input.modelConfirmed && !capOk) return Support.Unavailable(UnsupportedReason.MODEL_LACKS)
+
+        if (feature.needsVendorIdHook && !input.vendorIdHook) {
+            return Support.Unavailable(UnsupportedReason.NEEDS_VENDOR_ID_HOOK)
+        }
+
+        if (feature.needsCustomEqReport && !input.customEqReported) {
+            return Support.Unavailable(UnsupportedReason.NOT_REPORTED_BY_DEVICE)
+        }
+
+        val control = feature.controlId
+        if (control != null && control !in input.reportedControls) {
+            return Support.Unavailable(
+                if (input.modelConfirmed || capOk && feature.capability != null) UnsupportedReason.NOT_REPORTED_BY_DEVICE
+                else UnsupportedReason.MODEL_UNKNOWN
+            )
+        }
+
+        if (!input.modelConfirmed && control == null && !feature.needsCustomEqReport && feature.capability != null) {
+            // Purely model-based feature but we don't know the model for sure.
+            return Support.Unavailable(UnsupportedReason.MODEL_UNKNOWN)
+        }
+
+        if (feature.premium && !input.premium) return Support.Unavailable(UnsupportedReason.NEEDS_PREMIUM)
+        return Support.Available
+    }
+
+    fun evaluateAll(input: SupportInput): Map<Feature, Support> =
+        Feature.entries.associateWith { evaluate(it, input) }
+}
