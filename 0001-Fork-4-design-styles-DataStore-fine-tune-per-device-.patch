+    along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+// NOTE: this file must stay free of android.* imports — it is compiled and unit-tested on the JVM.
+package me.kavishdevar.librepods.data.support
+
+/**
+ * Which AACP control commands a per-device profile may capture / restore.
+ * Deliberately excluded: OWNS_CONNECTION, HEARING_AID/HEARING_ASSIST (medical, ATT-based),
+ * LISTENING_MODE (transient current mode), anything routing-related.
+ */
+object ProfileControls {
+    val CAPTURED: List<String> = listOf(
+        "LISTENING_MODE_CONFIGS",
+        "ONE_BUD_ANC_MODE",
+        "CONVERSATION_DETECT_CONFIG",
+        "ADAPTIVE_VOLUME_CONFIG",
+        "AUTO_ANC_STRENGTH",
+        "CHIME_VOLUME",
+        "DOUBLE_CLICK_INTERVAL",
+        "CLICK_HOLD_INTERVAL",
+        "VOLUME_SWIPE_INTERVAL",
+        "VOLUME_SWIPE_MODE",
+        "MIC_MODE",
+        "SLEEP_DETECTION_CONFIG",
+        "ALLOW_OFF_OPTION",
+        "CALL_MANAGEMENT_CONFIG",
+        "EAR_DETECTION_CONFIG",
+    )
+
+    /** Mirrors upstream's premium gates; everything else in [CAPTURED] is premium-gated upstream. */
+    val FREE: Set<String> = setOf(
+        "LISTENING_MODE_CONFIGS",
+        "MIC_MODE",
+        "CALL_MANAGEMENT_CONFIG",
+        "EAR_DETECTION_CONFIG",
+        "ALLOW_OFF_OPTION",
+    )
+}
+
+enum class SkipReason { NOT_REPORTED_BY_DEVICE, NEEDS_PREMIUM, ALREADY_EQUAL, NOT_ALLOWED }
+
+data class ApplyPlan(
+    val send: Map<String, ByteArray>,
+    val skipped: Map<String, SkipReason>,
+)
+
+object ProfileApplyPlanner {
+    /**
+     * @param snapshot identifier name → value bytes stored in the profile
+     * @param current  identifier name → value bytes the device reported (device-reported only)
+     */
+    fun plan(
+        snapshot: Map<String, ByteArray>,
+        current: Map<String, ByteArray>,
+        premium: Boolean,
+    ): ApplyPlan {
+        val send = linkedMapOf<String, ByteArray>()
+        val skipped = linkedMapOf<String, SkipReason>()
+        for ((id, value) in snapshot) {
+            when {
+                id !in ProfileControls.CAPTURED -> skipped[id] = SkipReason.NOT_ALLOWED
+                id !in current -> skipped[id] = SkipReason.NOT_REPORTED_BY_DEVICE
+                !premium && id !in ProfileControls.FREE -> skipped[id] = SkipReason.NEEDS_PREMIUM
+                current[id]?.contentEquals(value) == true -> skipped[id] = SkipReason.ALREADY_EQUAL
+                else -> send[id] = value
+            }
+        }
+        return ApplyPlan(send, skipped)
+    }
+
+    fun capture(current: Map<String, ByteArray>): Map<String, ByteArray> =
+        ProfileControls.CAPTURED.mapNotNull { id -> current[id]?.let { id to it.copyOf() } }.toMap()
+
+    fun toHex(bytes: ByteArray): String = bytes.joinToString("") { "%02X".format(it) }
+
+    fun fromHex(hex: String): ByteArray? {
+        if (hex.length % 2 != 0) return null
+        return try {
+            ByteArray(hex.length / 2) { i -> hex.substring(i * 2, i * 2 + 2).toInt(16).toByte() }
+        } catch (_: NumberFormatException) {
+            null
+        }
+    }
+}
