+@Composable
+fun FineTuneScreen(viewModel: AirPodsViewModel) {
+    val state by viewModel.uiState.collectAsState()
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val support = remember(state) { FeatureSupport.evaluateAll(state.toSupportInput()) }
+    fun reason(f: Feature): UnsupportedReason? = (support[f] as? Support.Unavailable)?.reason
+
+    val mac = remember {
+        context.getSharedPreferences("settings", MODE_PRIVATE).getString("mac_address", null)
+            ?.takeIf { it.isNotBlank() } ?: DeviceProfileRepository.UNKNOWN_DEVICE
+    }
