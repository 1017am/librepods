+@Composable
+fun StyleSettingsScreen() {
+    val context = LocalContext.current
+    val repo = remember { UiPreferencesRepository.get(context) }
+    val settings by repo.settings.collectAsState(initial = repo.legacyDefault())
+    val premium by BillingManager.provider.isPremium.collectAsState()
+    val scope = rememberCoroutineScope()
+    val locked = STYLE_SWITCH_REQUIRES_PREMIUM && !premium
+
+    val m3eEnabled = LocalDesignSystem.current == DesignSystem.Material
+    val topPadding = if (m3eEnabled) 0.dp else WindowInsets.statusBars.asPaddingValues().calculateTopPadding() + 84.dp
+    val bottomPadding = if (m3eEnabled) 16.dp else WindowInsets.navigationBars.asPaddingValues().calculateBottomPadding() + 16.dp
+
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.surfaceContainer)
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(20.dp)
+    ) {
+        Spacer(Modifier.height(topPadding))
+
+        ForkSection(
+            title = stringResource(R.string.fork_design_style),
+            description = if (locked) stringResource(R.string.fork_style_premium_locked) else null
+        ) {
+            Column(Modifier.selectableGroup()) {
+                AppStyle.entries.forEach { style ->
+                    StyleOption(
+                        style = style,
+                        selected = settings.style == style,
+                        enabled = !locked,
+                        onSelect = { scope.launch { repo.setStyle(style) } }
+                    )
+                }
+            }
+        }
+
+        ForkSection(
+            title = stringResource(R.string.fork_accessibility_display),
+            description = stringResource(R.string.fork_font_size_desc)
+        ) {
+            // Accessibility settings are never paywalled.
+            val fontFmt = stringResource(R.string.fork_font_size_value)
+            PreciseSlider(
+                label = stringResource(R.string.fork_font_size),
+                value = (settings.fontScale * 100).roundToInt(),
+                range = (MIN_FONT_SCALE * 100).roundToInt()..(MAX_FONT_SCALE * 100).roundToInt(),
+                step = 5,
+                valueText = { String.format(fontFmt, it) },
+                onValueChange = { v -> scope.launch { repo.setFontScale(v / 100f) } }
+            )
+            ForkSwitchRow(
+                label = stringResource(R.string.fork_high_contrast),
+                description = stringResource(R.string.fork_high_contrast_desc),
+                checked = settings.highContrast,
+                onCheckedChange = { v -> scope.launch { repo.setHighContrast(v) } }
+            )
+        }
+        Spacer(Modifier.height(bottomPadding))
+    }
+}
