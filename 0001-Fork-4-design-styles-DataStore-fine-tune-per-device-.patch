+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** SharedPreferences ("settings") keys. SharedPreferences (not DataStore) because the service
+ *  needs synchronous reads and already listens to this file. */
+object AutoConnectPrefs {
+    const val ENABLED = "auto_connect_enabled"
+    const val ON_LID_OPEN = "auto_connect_on_lid_open"
+    const val ON_IN_EAR = "auto_connect_on_in_ear"
+    const val ON_NEARBY = "auto_connect_on_nearby"
+    const val RSSI_THRESHOLD = "auto_connect_rssi_threshold"
+    const val RESPECT_OTHER_DEVICE = "auto_connect_respect_other_device"
+    const val MAX_ATTEMPTS = "auto_connect_max_attempts"
+    const val RECONNECT_ON_LINK_LOSS = "auto_connect_reconnect_on_link_loss"
+    const val START_ON_BOOT = "auto_connect_start_on_boot"
+
+    fun load(p: SharedPreferences) = AutoConnectSettings(
+        enabled = p.getBoolean(ENABLED, true),
+        onLidOpen = p.getBoolean(ON_LID_OPEN, true),
+        onInEar = p.getBoolean(ON_IN_EAR, true),
+        onNearby = p.getBoolean(ON_NEARBY, false),
+        nearbyRssiThreshold = p.getInt(RSSI_THRESHOLD, -60),
+        respectActiveOtherDevice = p.getBoolean(RESPECT_OTHER_DEVICE, true),
+        maxAttempts = p.getInt(MAX_ATTEMPTS, 5),
+        reconnectOnLinkLoss = p.getBoolean(RECONNECT_ON_LINK_LOSS, true),
+    )
+}
+
+/** Process-wide connection status for the UI. Written only by [AutoConnectManager]. */
+object AutoConnectState {
+    private val _status = MutableStateFlow(ConnectionStatus())
+    val status: StateFlow<ConnectionStatus> = _status.asStateFlow()
+
+    /** Non-null while AirPodsService runs; UI uses it for "connect now" / "resume". */
+    @Volatile
+    var manager: AutoConnectManager? = null
+        internal set
+
+    internal fun publish(value: ConnectionStatus) {
+        _status.value = value
+    }
+}
+
+/**
+ * Glue between BLE proximity broadcasts, the pure [AutoConnectController] and the existing
+ * AirPodsService.connectToSocket() (the only place an L2CAP/AACP socket is opened).
+ *
+ * What "connect" means here (and what it does NOT):
+ *  - We open the AACP L2CAP channel (PSM 0x1001) exactly like upstream. That pages the AirPods
+ *    and creates an ACL link.
+ *  - A2DP/HFP can only be connected by us with BLUETOOTH_PRIVILEGED (root module / system app).
+ *    Without it we rely on the AirPods (or Android) to bring the audio profiles up — whether
+ *    that happens after an app-initiated ACL is firmware/OS dependent (UNVERIFIED).
+ */
+class AutoConnectManager(
+    private val context: Context,
+    private val bleManager: BLEManager,
+    private val prefs: SharedPreferences,
+    private val connector: Connector,
+) {
+    interface Connector {
+        /** Blocking; must open the AACP socket (AirPodsService.connectToSocket). */
+        fun connectL2cap(adapter: BluetoothAdapter, device: BluetoothDevice)
+        fun isL2capConnected(): Boolean
+        /** Only called when BLUETOOTH_PRIVILEGED is granted. */
+        fun connectAudioProfiles(device: BluetoothDevice)
+        fun aacpBattery(): List<Battery>
+    }
+
+    private data class Entry(val sighting: Sighting, val status: BLEManager.AirPodsStatus)
+
+    private data class ControllerSnapshot(
+        val settings: AutoConnectSettings,
+        val target: Sighting?,
+        val connecting: Boolean,
+        val paused: Boolean,
+        val attempt: Int,
+        val blocked: Boolean,
+    )
+
+    private val lock = Any()
+    private val controller = AutoConnectController(System::currentTimeMillis, AutoConnectPrefs.load(prefs))
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val entries = ConcurrentHashMap<String, Entry>()
+
+    private var connectJob: Job? = null
+    private val l2capInFlight = AtomicBoolean(false)
+    private val controllerOwnsAttempt = AtomicBoolean(false)
+    private val userDisconnectPending = AtomicBoolean(false)
+
+    @Volatile private var nextRetryAt: Long? = null
+    @Volatile private var lastFailure: Pair<FailureReason, String?>? = null
+    @Volatile private var connectedAddress: String? = null
+    @Volatile private var started = false
+
+    private val prefListener = SharedPreferences.OnSharedPreferenceChangeListener { p, changedKey ->
+        val key = changedKey ?: return@OnSharedPreferenceChangeListener
+        when {
+            key.startsWith("auto_connect_") -> {
+                synchronized(lock) { controller.updateSettings(AutoConnectPrefs.load(p)) }
+                refresh()
+            }
+            key == BLEManager.PREF_SCAN_MODE -> scope.launch { bleManager.startScanning() }
+            key == "mac_address" || key.startsWith(AACPManager.Companion.ProximityKeyType.IRK.name) -> refresh()
+        }
+    }
+
+    private val adapterStateReceiver = object : BroadcastReceiver() {
+        override fun onReceive(c: Context?, intent: Intent?) {
+            if (intent?.action != BluetoothAdapter.ACTION_STATE_CHANGED) return
+            when (intent.getIntExtra(BluetoothAdapter.EXTRA_STATE, BluetoothAdapter.ERROR)) {
+                BluetoothAdapter.STATE_ON -> {
+                    Log.d(TAG, "Bluetooth on → restarting BLE scan")
+                    lastFailure = null
+                    scope.launch { bleManager.startScanning() }
+                    refresh()
+                }
+                BluetoothAdapter.STATE_TURNING_OFF, BluetoothAdapter.STATE_OFF -> {
+                    entries.clear()
+                    synchronized(lock) { controller.onAllDisappeared() }
+                    connectJob?.cancel()
+                    refresh()
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // Lifecycle
+    // ------------------------------------------------------------------------------------------
+
+    fun start() {
+        if (started) return
+        started = true
+        prefs.registerOnSharedPreferenceChangeListener(prefListener)
+        context.registerReceiver(
+            adapterStateReceiver,
+            IntentFilter(BluetoothAdapter.ACTION_STATE_CHANGED),
+            Context.RECEIVER_NOT_EXPORTED
+        )
+        AutoConnectState.manager = this
+        refresh()
+    }
+
+    fun stop() {
+        if (!started) return
+        started = false
+        try {
+            prefs.unregisterOnSharedPreferenceChangeListener(prefListener)
+            context.unregisterReceiver(adapterStateReceiver)
+        } catch (e: Exception) {
+            Log.w(TAG, "stop(): ${e.message}")
+        }
+        scope.cancel()
+        if (AutoConnectState.manager === this) AutoConnectState.manager = null
+        AutoConnectState.publish(ConnectionStatus(phase = ConnectionPhase.IDLE, updatedAtMillis = now()))
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // Inputs from BLEManager (main thread)
+    // ------------------------------------------------------------------------------------------
+
+    fun onBleStatus(status: BLEManager.AirPodsStatus) {
+        val t = now()
+        val identity = bleManager.identityFor(status.address)
+        val sighting = Sighting(
+            rpa = status.address,
+            identityAddress = identity,
+            rssi = bleManager.rssiFor(status.address) ?: -127,
+            lidOpen = status.lidOpen,
+            leftInEar = status.isLeftInEar,
+            rightInEar = status.isRightInEar,
+            remoteState = status.connectionState,
+            seenAtMillis = t,
+        )
+        // Key by identity so RPA rotation (~15 min) doesn't look like a fresh "lid opened" edge.
+        val key = identity ?: status.address
+        val prev = entries.put(key, Entry(sighting, status))?.sighting
+        val nearby = fresh(t).map { it.sighting }
+        val action = synchronized(lock) { controller.onSighting(prev, sighting, nearby) }
+        if (action is AutoConnectController.Action.Connect) {
+            Log.i(TAG, "BLE trigger ${action.trigger} for ${sighting.identityAddress ?: sighting.rpa}")
+        }
+        execute(action)
+    }
+
+    fun onAllDisappeared() {
+        entries.clear()
+        synchronized(lock) { controller.onAllDisappeared() }
+        lastFailure = null
+        refresh()
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // Inputs from AirPodsService
+    // ------------------------------------------------------------------------------------------
+
+    /** Called at the top of AirPodsService.connectToSocket(), whoever initiated it. */
+    fun reportConnecting(device: BluetoothDevice) {
+        l2capInFlight.set(true)
+        connectedAddress = null
+        refresh { it.copy(phase = ConnectionPhase.CONNECTING, identityAddress = device.address) }
+    }
+
+    fun reportConnected(device: BluetoothDevice) {
+        l2capInFlight.set(false)
+        connectedAddress = device.address
+        lastFailure = null
+        nextRetryAt = null
+        synchronized(lock) { controller.onConnectSucceeded(device.address) }
+        rememberIdentity(device.address)
+        refresh()
+    }
+
+    fun reportFailed(reason: FailureReason, detail: String?) {
+        l2capInFlight.set(false)
+        lastFailure = reason to detail
+        // If the controller started this attempt, launchConnect() decides about retries.
+        if (!controllerOwnsAttempt.get()) refresh()
+    }
+
+    fun onL2capDisconnected() {
+        if (!synchronized(lock) { controller.connected }) {
+            connectedAddress = null
+            refresh()
+            return
+        }
+        val userInitiated = userDisconnectPending.getAndSet(false)
+        val address = connectedAddress
+        connectedAddress = null
+        val stillActive = fresh(now()).any {
+            it.sighting.active && (address == null || it.sighting.identityAddress == null ||
+                it.sighting.identityAddress.equals(address, ignoreCase = true))
+        }
+        val action = synchronized(lock) { controller.onDisconnected(userInitiated, stillActive) }
+        Log.d(TAG, "L2CAP disconnected (user=$userInitiated, stillActive=$stillActive) → $action")
+        execute(action)
+    }
+
+    fun onUserDisconnect() {
+        userDisconnectPending.set(true)
+        connectJob?.cancel()
+    }
+
+    fun onOtherDeviceTookOver() {
+        synchronized(lock) { controller.onOtherDeviceTookOver() }
+        refresh()
+    }
+
+    fun onAacpBattery() = refresh()
+
+    // ------------------------------------------------------------------------------------------
+    // Inputs from the UI
+    // ------------------------------------------------------------------------------------------
+
+    fun connectNow() {
+        val nearby = fresh(now()).map { it.sighting }
+        execute(synchronized(lock) { controller.onManualConnect(nearby) })
+    }
+
+    fun resume() {
+        synchronized(lock) { controller.clearPause() }
+        refresh()
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // Execution
+    // ------------------------------------------------------------------------------------------
+
+    private fun execute(action: AutoConnectController.Action) {
+        when (action) {
+            AutoConnectController.Action.None -> refresh()
+            AutoConnectController.Action.GiveUp -> {
+                nextRetryAt = null
+                if (lastFailure == null) lastFailure = FailureReason.UNKNOWN to null
+                refresh()
+            }
+            is AutoConnectController.Action.Connect -> launchConnect(action)
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun launchConnect(action: AutoConnectController.Action.Connect) {
+        connectJob?.cancel()
+        connectJob = scope.launch {
+            if (action.delayMs > 0) {
+                nextRetryAt = now() + action.delayMs
+                refresh()
+                delay(action.delayMs)
+            }
+            nextRetryAt = null
+
+            if (connector.isL2capConnected()) {
+                synchronized(lock) { controller.onConnectSucceeded(connectedAddress) }
+                refresh(); return@launch
+            }
+            if (l2capInFlight.get()) {
+                // System ACL path (or the user) is already connecting; let that one finish.
+                synchronized(lock) { controller.onConnectAborted() }
+                refresh(); return@launch
+            }
+            val retryWithoutDevice = action.attempt > 1 &&
+                action.trigger != Trigger.MANUAL && fresh(now()).isEmpty()
+            if (retryWithoutDevice) {
+                Log.d(TAG, "AirPods no longer nearby, dropping retry")
+                synchronized(lock) { controller.onConnectAborted() }
+                lastFailure = null
+                refresh(); return@launch
+            }
+            if (!AutoConnectPermissions.hasScanAndConnect(context)) {
+                synchronized(lock) { controller.onConnectAborted() }
+                lastFailure = FailureReason.PERMISSION to null
+                refresh(); return@launch
+            }
+            val adapter = adapter()
+            if (adapter == null || !adapter.isEnabled) {
+                synchronized(lock) { controller.onConnectAborted() }
+                lastFailure = FailureReason.BLUETOOTH_OFF to null
+                refresh(); return@launch
+            }
+            val device = resolveBondedDevice(adapter, action.target)
+            if (device == null) {
+                synchronized(lock) { controller.onConnectAborted() }
+                lastFailure = FailureReason.NOT_BONDED to (action.target?.identityAddress ?: savedMac())
+                refresh(); return@launch
+            }
+
+            Log.i(TAG, "Auto-connect attempt ${action.attempt} (${action.trigger}) → ${device.address}")
+            lastFailure = null
+            controllerOwnsAttempt.set(true)
+            try {
+                connector.connectL2cap(adapter, device)
+            } catch (t: Throwable) {
+                Log.w(TAG, "connectL2cap threw", t)
+                lastFailure = FailureReason.SOCKET_ERROR to t.message
+            } finally {
+                controllerOwnsAttempt.set(false)
+                l2capInFlight.set(false)
+            }
+
+            if (connector.isL2capConnected()) {
+                // reportConnected() already ran inside connectToSocket.
+                if (AutoConnectPermissions.hasPrivilegedBluetooth(context)) {
+                    try {
+                        connector.connectAudioProfiles(device)
+                    } catch (t: Throwable) {
+                        Log.w(TAG, "connectAudioProfiles failed", t)
+                    }
+                }
+                refresh()
+            } else {
+                execute(synchronized(lock) { controller.onConnectFailed() })
+            }
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun resolveBondedDevice(adapter: BluetoothAdapter, target: Sighting?): BluetoothDevice? {
+        val candidates = listOfNotNull(
+            target?.identityAddress,
+            synchronized(lock) { controller.lastConnectedIdentity },
+            savedMac()
+        ).distinct()
+        val bonded = try {
+            adapter.bondedDevices ?: emptySet()
+        } catch (e: SecurityException) {
+            return null
+        }
+        for (mac in candidates) {
+            bonded.firstOrNull { it.address.equals(mac, ignoreCase = true) }?.let { return it }
+        }
+        return null
+    }
+
+    private fun rememberIdentity(address: String) {
+        val known = prefs.getStringSet(BLEManager.PREF_KNOWN_AIRPODS, emptySet()) ?: emptySet()
+        if (address.uppercase() !in known) {
+            // Copy: the set returned by getStringSet must not be modified.
+            prefs.edit().putStringSet(BLEManager.PREF_KNOWN_AIRPODS, known + address.uppercase()).apply()
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // Status publishing
+    // ------------------------------------------------------------------------------------------
+
+    private fun refresh(transform: (ConnectionStatus) -> ConnectionStatus = { it }) {
+        val t = now()
+        val nearby = fresh(t)
+        val snap = synchronized(lock) {
+            ControllerSnapshot(
+                settings = controller.settings,
+                target = controller.selectTarget(nearby.map { it.sighting }),
+                connecting = controller.connecting,
+                paused = controller.paused,
+                attempt = controller.attempt,
+                blocked = false,
+            ).let { it.copy(blocked = it.target?.let(controller::isBlockedByOtherHost) == true) }
+        }
+        val settings = snap.settings
+        val target = snap.target
+        val connecting = snap.connecting
+        val paused = snap.paused
+        val attempt = snap.attempt
+        val targetEntry = nearby.firstOrNull { it.sighting.rpa == target?.rpa }
+        val connected = connector.isL2capConnected()
+        val failure = lastFailure
+
+        val phase = when {
+            connected -> ConnectionPhase.CONNECTED
+            l2capInFlight.get() || connecting -> ConnectionPhase.CONNECTING
+            !AutoConnectPermissions.hasScanAndConnect(context) -> ConnectionPhase.MISSING_PERMISSION
+            adapter()?.isEnabled != true -> ConnectionPhase.BLUETOOTH_OFF
+            savedMac() == null && !bleManager.hasAnyIrk() -> ConnectionPhase.NO_PAIRED_DEVICE
+            !bleManager.hasAnyIrk() -> ConnectionPhase.NO_PROXIMITY_KEYS
+            paused -> ConnectionPhase.PAUSED
+            failure != null -> ConnectionPhase.FAILED
+            target != null && snap.blocked -> ConnectionPhase.IN_USE_ELSEWHERE
+            target != null -> ConnectionPhase.NEARBY
+            else -> ConnectionPhase.SEARCHING
+        }
+
+        val battery = (if (connected) aacpSnapshot() else null) ?: targetEntry?.let { bleSnapshot(it) }
+        val ownPairs = nearby.map { it.sighting.identityAddress ?: it.sighting.rpa }.distinct().size
+
+        val status = ConnectionStatus(
+            phase = phase,
+            deviceName = prefs.getString("name", null),
+            identityAddress = connectedAddress ?: target?.identityAddress ?: savedMac(),
+            battery = battery,
+            lidOpen = target?.lidOpen ?: false,
+            leftInEar = target?.leftInEar ?: false,
+            rightInEar = target?.rightInEar ?: false,
+            rssi = target?.rssi,
+            attempt = attempt,
+            maxAttempts = settings.maxAttempts,
+            nextRetryAtMillis = nextRetryAt,
+            failure = if (phase == ConnectionPhase.FAILED) failure?.first else null,
+            failureDetail = if (phase == ConnectionPhase.FAILED) failure?.second else null,
+            otherOwnDevicesNearby = (ownPairs - if (target != null) 1 else 0).coerceAtLeast(0),
+            canConnectAudioProfiles = AutoConnectPermissions.hasPrivilegedBluetooth(context),
+            updatedAtMillis = t,
+        )
+        AutoConnectState.publish(transform(status))
+    }
+
+    private fun aacpSnapshot(): BatterySnapshot? {
+        val list = try {
+            connector.aacpBattery()
+        } catch (_: Exception) {
+            emptyList()
+        }
+        fun bud(component: Int): BudBattery {
+            val b = list.firstOrNull { it.component == component }
+            if (b == null || b.status == BatteryStatus.DISCONNECTED) return BudBattery(null)
+            return BudBattery(
+                b.level,
+                b.status == BatteryStatus.CHARGING || b.status == BatteryStatus.OPTIMIZED_CHARGING
+            )
+        }
+        val snap = BatterySnapshot(
+            bud(BatteryComponent.LEFT), bud(BatteryComponent.RIGHT), bud(BatteryComponent.CASE),
+            BatterySource.AACP
+        )
+        return if (snap.left.level == null && snap.right.level == null && snap.case.level == null) null else snap
+    }
+
+    private fun bleSnapshot(e: Entry): BatterySnapshot {
+        val s = e.status
+        val encName = AACPManager.Companion.ProximityKeyType.ENC_KEY.name
+        val hasEnc = prefs.contains(encName) ||
+            (e.sighting.identityAddress?.let { prefs.contains(BLEManager.keyPrefName(encName, it)) } == true)
+        return BatterySnapshot(
+            BudBattery(s.leftBattery, s.isLeftCharging),
+            BudBattery(s.rightBattery, s.isRightCharging),
+            BudBattery(s.caseBattery, s.isCaseCharging),
+            if (hasEnc) BatterySource.BLE_DECRYPTED else BatterySource.BLE_ESTIMATE
+        )
+    }
+
+    private fun fresh(t: Long): List<Entry> =
+        entries.values.filter { t - it.sighting.seenAtMillis <= AutoConnectController.SIGHTING_FRESH_MS }
+
+    private fun savedMac(): String? = prefs.getString("mac_address", null)?.takeIf { it.isNotBlank() }
+
+    private fun adapter(): BluetoothAdapter? =
+        context.getSystemService(BluetoothManager::class.java)?.adapter
+
+    private fun now() = System.currentTimeMillis()
+
+    companion object {
+        private const val TAG = "AutoConnect"
+    }
+}
